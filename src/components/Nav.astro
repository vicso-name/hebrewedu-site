---
import { site } from '../data/site';
import { coursePath, hubEnabled, localCoursePreview } from '../lib/alphabet-course.mjs';
import { phrasesPath } from '../lib/hebrew-phrases.mjs';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
  /** Small language-switch link, shown only on pages that have a counterpart (Stage B §1/§4). */
  langSwitch?: { href: string; label: string };
}
const { locale = 'en', langSwitch } = Astro.props;
const t = getDictionary(locale);

const showCourse = hubEnabled(localCoursePreview(import.meta.env.DEV));
// FR has its own, much smaller link set — there's no FR blog/phrases page yet,
// and /play/ is English-only, so it's labeled as such rather than translated.
const links = locale === 'fr'
  ? [
      { label: t.nav.home, href: '/fr/' },
      { label: t.nav.alphabetCourse, href: '/fr/alphabet-hebreu/' },
      { label: t.common.gamesEnLabel, href: '/play/' },
    ]
  : [
      { label: t.nav.play, href: '/play/' },
      ...(showCourse ? [{ label: t.nav.alphabetCourse, href: coursePath }] : []),
      { label: t.nav.phrases, href: phrasesPath },
      { label: t.nav.blog,    href: '/blog/'    },
    ];
const ctaHref = locale === 'fr' ? '/fr/#download' : site.appDownloadUrl;
const ctaLabel = locale === 'fr' ? t.common.application : t.common.getTheApp;
---

<header class:list={['nav-wrap', { 'course-nav': showCourse }]}>
  <nav class="container nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="HebrewEdu home">
      {t.common.brand}
    </a>

    <ul class="nav-links" role="list">
      {links.map(l => (
        <li><a href={l.href} class="nav-link" aria-current={l.href === coursePath && Astro.url.pathname.startsWith(coursePath) ? (Astro.url.pathname === coursePath ? 'page' : 'location') : undefined}>{l.label}</a></li>
      ))}
    </ul>

    <a href={ctaHref} class="nav-cta" data-cta-location="nav">
      {ctaLabel}
    </a>

    {langSwitch && <a href={langSwitch.href} class="nav-lang-switch">{langSwitch.label}</a>}

    <button
      type="button"
      class="nav-burger"
      id="nav-burger"
      aria-label={t.common.openMenu}
      aria-expanded="false"
      aria-controls="nav-mobile"
      data-desktop-breakpoint={showCourse ? '1101' : '769'}
      data-open-label={t.common.openMenu}
      data-close-label={t.common.closeMenu}
    >
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- Fixed over the page content, so it lives outside the header. `hidden` keeps
     its links out of the tab order while the menu is closed. -->
<div class:list={['nav-mobile', { 'course-nav': showCourse }]} id="nav-mobile" hidden>
  <div class="nav-mobile-inner">
    {links.map(l => (
      <a href={l.href} class="nav-mobile-link" aria-current={l.href === coursePath && Astro.url.pathname.startsWith(coursePath) ? (Astro.url.pathname === coursePath ? 'page' : 'location') : undefined}>{l.label}</a>
    ))}
    <a href={ctaHref} class="nav-mobile-cta" data-cta-location="nav_mobile">
      {ctaLabel}
    </a>
    {langSwitch && <a href={langSwitch.href} class="nav-mobile-lang-switch">{langSwitch.label}</a>}
  </div>
</div>

<style>
/* The --nav-* custom properties are theming hooks. Pages that don't set them
   (blog, privacy, terms) keep the original look via the fallbacks. */
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 200;
  background: var(--nav-bg, rgba(248, 248, 246, 0.85));
  box-shadow: 0 1px 0 var(--nav-border, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 68px;
}

.nav-logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--ink-light);
  letter-spacing: 0.06em;
  position: relative;
  padding-bottom: 2px;
  transition: color 0.25s;
}

.nav-logo::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1.5px;
  background: var(--ink-light);
  border-radius: 2px;
  transition: background 0.25s;
}

.nav-logo:hover { color: var(--ink); }
.nav-logo:hover::after { background: var(--ink); }

.nav-links { display: flex; list-style: none; gap: 0.25rem; margin-inline-start: auto; }
.nav-link {
  padding: 0.4rem 0.875rem;
  border-radius: var(--r-full);
  font-size: 0.9375rem;
  color: var(--ink-light);
  transition: color 0.15s, background 0.15s;
}
.nav-link:hover { color: var(--ink); background: var(--nav-link-hover-bg, var(--brand-light)); }
.nav-link[aria-current], .nav-mobile-link[aria-current] { color: var(--ink); text-decoration: underline; text-underline-offset: .3em; }

.nav-cta {
  display: inline-flex;
  align-items: center;
  margin-inline-start: 0.5rem;
  padding: 0.55rem 1.25rem;
  background: var(--ink);
  color: white;
  border-radius: var(--r-full);
  font-size: 0.875rem;
  font-weight: 600;
  transition: background 0.15s;
  white-space: nowrap;
}
.nav-cta:hover { background: #111827; }

.nav-lang-switch {
  margin-inline-start: var(--space-xs);
  padding: 0.4rem 0.625rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--ink-light);
  border-radius: var(--r-full);
  transition: color 0.15s, background 0.15s;
  white-space: nowrap;
}
.nav-lang-switch:hover { color: var(--ink); background: var(--brand-light); }

.nav-logo:focus-visible,
.nav-link:focus-visible,
.nav-cta:focus-visible,
.nav-lang-switch:focus-visible,
.nav-burger:focus-visible,
.nav-mobile-link:focus-visible,
.nav-mobile-cta:focus-visible,
.nav-mobile-lang-switch:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}

/* ── Burger ── */
.nav-burger {
  display: none;
  min-width: 44px;
  min-height: 44px;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.375rem;
  margin-inline-start: auto;
  position: relative;
  z-index: 201;
}
.nav-burger span {
  display: block;
  width: 22px; height: 2px;
  background: var(--ink);
  border-radius: 2px;
  transition: transform 0.25s, opacity 0.2s;
  transform-origin: center;
}
.nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── Mobile menu ── */
.nav-mobile {
  position: fixed;
  top: 68px;
  left: 0; right: 0;
  z-index: 190;
  max-height: calc(100dvh - 68px);
  overflow-y: auto;
  background: var(--nav-bg, rgba(248, 248, 246, 0.85));
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-mobile[hidden] { display: none; }

.nav-mobile-inner {
  display: flex;
  flex-direction: column;
  padding: 0.75rem 1.5rem 1.75rem;
}

.nav-mobile-link {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 500;
  color: var(--ink-light);
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--border);
  transition: color 0.15s;
  display: block;
}
.nav-mobile-link:hover { color: var(--ink); }

.nav-mobile-cta {
  display: block;
  margin-top: 1.25rem;
  padding: 0.875rem;
  background: var(--ink);
  color: white;
  border-radius: var(--r-full);
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  text-align: center;
  transition: background 0.15s;
}
.nav-mobile-cta:hover { background: #111827; }

.nav-mobile-lang-switch {
  display: block;
  margin-top: var(--space-sm);
  padding: var(--space-xs) 0;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--ink-light);
  text-align: center;
}
.nav-mobile-lang-switch:hover { color: var(--ink); }

@media (max-width: 768px) {
  .nav-inner { gap: var(--space-sm); }
  .nav-links, .nav-cta, .nav-lang-switch { display: none; }
  .nav-burger { display: flex; }
}

@media (min-width: 769px) {
  .nav-mobile { display: none; }
}

/* Allow space for the extra course entry without compressing tablet navigation. */
@media (min-width: 769px) and (max-width: 1100px) {
  .course-nav .nav-links, .course-nav .nav-cta, .course-nav .nav-lang-switch { display: none; }
  .course-nav .nav-burger { display: flex; }
  .nav-mobile.course-nav:not([hidden]) { display: block; }
}
</style>

<script>
const burger = document.getElementById('nav-burger') as HTMLButtonElement;
const menu   = document.getElementById('nav-mobile') as HTMLElement;

const isOpen = () => !menu.hasAttribute('hidden');

function setOpen(open: boolean) {
  menu.hidden = !open;
  burger.classList.toggle('is-open', open);
  burger.setAttribute('aria-expanded', String(open));
  burger.setAttribute('aria-label', open ? burger.dataset.closeLabel ?? 'Close menu' : burger.dataset.openLabel ?? 'Open menu');
}

burger.addEventListener('click', () => setOpen(!isOpen()));

menu.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => setOpen(false));
});

// Close on outside click
document.addEventListener('click', (e) => {
  const target = e.target as Node;
  if (isOpen() && !menu.contains(target) && !burger.contains(target)) setOpen(false);
});

// Escape closes and hands focus back to the toggle
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && isOpen()) {
    setOpen(false);
    burger.focus();
  }
});

// Reset when the viewport grows past the mobile breakpoint
window.matchMedia(`(min-width: ${burger.dataset.desktopBreakpoint ?? '769'}px)`).addEventListener('change', (e) => {
  if (e.matches) setOpen(false);
});
</script>
