---
import { site } from '../data/site';

const links = [
  { label: 'Features',     href: '/#features'     },
  { label: 'How it works', href: '/#how-it-works'  },
  { label: 'Reviews',      href: '/#reviews'       },
  { label: 'Blog',         href: '/blog/'          },
];
---

<header class="nav-wrap">
  <nav class="container nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="HebrewEdu home">
      HEBREWEDU
    </a>

    <ul class="nav-links" role="list">
      {links.map(l => (
        <li><a href={l.href} class="nav-link">{l.label}</a></li>
      ))}
    </ul>

    <a href={site.primaryStoreUrl} class="nav-cta" target="_blank" rel="noopener">
      Get the app
    </a>

    <button
      type="button"
      class="nav-burger"
      id="nav-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- Fixed over the page content, so it lives outside the header. `hidden` keeps
     its links out of the tab order while the menu is closed. -->
<div class="nav-mobile" id="nav-mobile" hidden>
  <div class="nav-mobile-inner">
    {links.map(l => (
      <a href={l.href} class="nav-mobile-link">{l.label}</a>
    ))}
    <a href={site.primaryStoreUrl} class="nav-mobile-cta" target="_blank" rel="noopener">
      Get the app
    </a>
  </div>
</div>

<style>
/* The --nav-* custom properties are theming hooks. Pages that don't set them
   (blog, privacy, terms) keep the original look via the fallbacks. */
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 200;
  background: var(--nav-bg, rgba(248, 248, 246, 0.85));
  box-shadow: 0 1px 0 var(--nav-border, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 68px;
}

.nav-logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--ink-light);
  letter-spacing: 0.06em;
  position: relative;
  padding-bottom: 2px;
  transition: color 0.25s;
}

.nav-logo::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1.5px;
  background: var(--ink-light);
  border-radius: 2px;
  transition: background 0.25s;
}

.nav-logo:hover { color: var(--ink); }
.nav-logo:hover::after { background: var(--ink); }

.nav-links { display: flex; list-style: none; gap: 0.25rem; margin-inline-start: auto; }
.nav-link {
  padding: 0.4rem 0.875rem;
  border-radius: var(--r-full);
  font-size: 0.9375rem;
  color: var(--ink-light);
  transition: color 0.15s, background 0.15s;
}
.nav-link:hover { color: var(--ink); background: var(--nav-link-hover-bg, var(--brand-light)); }

.nav-cta {
  display: inline-flex;
  align-items: center;
  margin-inline-start: 0.5rem;
  padding: 0.55rem 1.25rem;
  background: var(--ink);
  color: white;
  border-radius: var(--r-full);
  font-size: 0.875rem;
  font-weight: 600;
  transition: background 0.15s;
  white-space: nowrap;
}
.nav-cta:hover { background: #111827; }

.nav-logo:focus-visible,
.nav-link:focus-visible,
.nav-cta:focus-visible,
.nav-burger:focus-visible,
.nav-mobile-link:focus-visible,
.nav-mobile-cta:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}

/* ── Burger ── */
.nav-burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.375rem;
  margin-inline-start: auto;
  position: relative;
  z-index: 201;
}
.nav-burger span {
  display: block;
  width: 22px; height: 2px;
  background: var(--ink);
  border-radius: 2px;
  transition: transform 0.25s, opacity 0.2s;
  transform-origin: center;
}
.nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-burger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── Mobile menu ── */
.nav-mobile {
  position: fixed;
  top: 68px;
  left: 0; right: 0;
  z-index: 190;
  max-height: calc(100dvh - 68px);
  overflow-y: auto;
  background: var(--nav-bg, rgba(248, 248, 246, 0.85));
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-mobile[hidden] { display: none; }

.nav-mobile-inner {
  display: flex;
  flex-direction: column;
  padding: 0.75rem 1.5rem 1.75rem;
}

.nav-mobile-link {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 500;
  color: var(--ink-light);
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--border);
  transition: color 0.15s;
  display: block;
}
.nav-mobile-link:hover { color: var(--ink); }

.nav-mobile-cta {
  display: block;
  margin-top: 1.25rem;
  padding: 0.875rem;
  background: var(--ink);
  color: white;
  border-radius: var(--r-full);
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  text-align: center;
  transition: background 0.15s;
}
.nav-mobile-cta:hover { background: #111827; }

@media (max-width: 768px) {
  .nav-links, .nav-cta { display: none; }
  .nav-burger { display: flex; }
}

@media (min-width: 769px) {
  .nav-mobile { display: none; }
}
</style>

<script>
const burger = document.getElementById('nav-burger') as HTMLButtonElement;
const menu   = document.getElementById('nav-mobile') as HTMLElement;

const isOpen = () => !menu.hasAttribute('hidden');

function setOpen(open: boolean) {
  menu.hidden = !open;
  burger.classList.toggle('is-open', open);
  burger.setAttribute('aria-expanded', String(open));
  burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
}

burger.addEventListener('click', () => setOpen(!isOpen()));

menu.querySelectorAll('a').forEach(link => {
  link.addEventListener('click', () => setOpen(false));
});

// Close on outside click
document.addEventListener('click', (e) => {
  const target = e.target as Node;
  if (isOpen() && !menu.contains(target) && !burger.contains(target)) setOpen(false);
});

// Escape closes and hands focus back to the toggle
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && isOpen()) {
    setOpen(false);
    burger.focus();
  }
});

// Reset when the viewport grows past the mobile breakpoint
window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
  if (e.matches) setOpen(false);
});
</script>
