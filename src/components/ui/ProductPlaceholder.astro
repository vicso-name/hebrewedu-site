---
// Temporary stand-in for a product screenshot. It only reserves the space a
// phone screenshot will take; it is decorative and hidden from assistive tech.
// When real screenshots replace it they will need meaningful alt text.
interface Props {
  label: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { label, variant = 'primary', class: className, ...rest } = Astro.props;
---

<div class:list={['placeholder', `placeholder--${variant}`, className]} aria-hidden="true" {...rest}>
  <div class="placeholder-screen">
    <span class="placeholder-label">{label}</span>
    <span class="placeholder-note">Screenshot placeholder</span>
  </div>
</div>

<style>
.placeholder {
  width: 100%;
  aspect-ratio: 9 / 19.5;
  padding: 8px;
  background: var(--home-surface-white);
  border: 1px solid var(--home-border-strong);
  border-radius: calc(var(--home-radius-lg) + 8px);
}
.placeholder--primary { box-shadow: 0 28px 56px -32px rgba(23, 23, 26, 0.22); }

.placeholder-screen {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  background: var(--home-surface-soft);
  border: 1px solid var(--home-border-subtle);
  border-radius: var(--home-radius-lg);
  text-align: center;
}

.placeholder-label {
  font-size: 1rem;
  font-weight: 600;
  color: var(--home-text-secondary);
}
.placeholder-note {
  font-size: 0.75rem;
  color: var(--home-text-tertiary);
}
/* The secondary frame sits partly behind another one; keep its label in the visible edge */
.placeholder--secondary .placeholder-screen { align-items: flex-end; padding-right: 12%; }
.placeholder--secondary .placeholder-note { display: none; }
</style>
