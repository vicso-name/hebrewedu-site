---
import Section from './Section.astro';
interface Props {
  compact?: boolean;
  id?: string;
}

const { compact = false, id } = Astro.props;
---

<Section id={id} surface="white">
    <div class:list={['cta-panel', { 'cta-panel--compact': compact }]}>
      <slot />
    </div>
</Section>

<style>
.cta-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-2xl) var(--space-xl);
  background: var(--home-surface-soft);
  border-radius: var(--home-radius-lg);
  text-align: center;
}
.cta-panel :global(p) {
  max-width: var(--w-narrow);
  margin-block: var(--space-sm) var(--space-lg);
}

.cta-panel--compact {
  padding-block: var(--space-xl);
}
@media (max-width: 767px) {
  .cta-panel { padding: var(--space-lg) var(--space-md); }
}
</style>
