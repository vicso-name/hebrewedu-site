---
import { site, storeHref } from '../../data/site';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  /** Where the buttons sit, reported as cta_location on click events. */
  location: string;
  /** Optional additional click event used by the blog CTA. */
  trackAlso?: string;
  height?: number;
  locale?: Locale;
}
const { location, trackAlso, height = 56, locale = 'en' } = Astro.props;
const t = getDictionary(locale);

// Only stores with a live URL are rendered.
const stores = [site.stores.appStore, site.stores.googlePlay]
  .filter(s => s.url)
  .map(s => ({ ...s, href: storeHref(s, locale), label: t.common.storeLabels[s.id] }));
---

<div class="store-buttons" style={`--store-badge-height: ${height}px`}>
  {stores.map(s => (
    <a href={s.href} class="store-link" target="_blank" rel="noopener" data-store={s.id} data-cta-location={location} data-track-also={trackAlso}>
      <img src={s.badge} alt={s.label} width={Math.round(s.width * height / s.height)} height={height} />
    </a>
  ))}
</div>

<style>
.store-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.875rem;
}
.store-link {
  display: block;
  border-radius: var(--home-radius-sm);
  transition: opacity 0.15s;
}
.store-link:hover { opacity: 0.85; }
.store-link:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
}
.store-link img { height: var(--store-badge-height); width: auto; }
</style>
