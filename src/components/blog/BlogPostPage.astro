---
// Shared blog-article template: src/pages/blog/[slug].astro and
// src/pages/fr/blog/[slug].astro both render through it, so neither owns a page
// shell of its own (docs/I18N.md §2, LAYOUT_WRAPPERS in
// scripts/check-layout.mjs). It renders Layout.astro internally, the same
// pattern as AlphabetLessonPage.astro.
import { render } from 'astro:content';
import Layout, { type Alternate } from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import RelatedPosts from './RelatedPosts.astro';
import StoreButtons from '../ui/StoreButtons.astro';
import Faq from '../Faq.astro';
import { blogPath, formatPostDate, type BlogPost } from '../../lib/blog';
import { site } from '../../data/site';
import { phrasesPath, phrasesPathFr, phrasesPublished, phrasesPublishedFr } from '../../lib/hebrew-phrases.mjs';
import { phraseReview } from '../../data/hebrew-phrases';
import { getDictionary, type Locale } from '../../i18n';
import '../../styles/blog.css';

interface Props {
  post: BlogPost;
  /** Up to three other posts in the same locale. */
  related: BlogPost[];
  locale?: Locale;
  /** hreflang alternates; omitted when this post has no counterpart (docs/I18N.md §3). */
  alternates?: Alternate[];
  langSwitch?: { href: string };
}

const { post, related, locale = 'en', alternates, langSwitch } = Astro.props;
const t = getDictionary(locale);
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, category, categoryKey, readingTime } = post.data;

// `categoryKey` keeps the two locales on one taxonomy; `category` is the label
// for a post that predates the key (src/content.config.ts).
const categoryLabel = categoryKey
  ? t.blog.categories[categoryKey as keyof typeof t.blog.categories] ?? category
  : category;

// The vocabulary post cross-links the phrases page — each locale to its own
// (docs/I18N.md §3.1: a FR page links to FR pages).
const pairKey = post.data.translationKey ?? post.id;
const isVocabularyPost = pairKey === 'how-to-learn-hebrew-vocabulary';
const showPhrasesLink = isVocabularyPost && (locale === 'fr' ? phrasesPublishedFr() : phrasesPublished());
const phrasesHref = locale === 'fr' ? phrasesPathFr : phrasesPath;
const contentDates = [updatedDate, ...(showPhrasesLink ? [new Date(phraseReview.publishedAt!)] : [])].filter((date): date is Date => date !== undefined);
const contentUpdatedDate = contentDates.sort((a, b) => b.getTime() - a.getTime())[0];

const formattedDate = formatPostDate(pubDate, locale);

// BlogPosting JSON-LD, from frontmatter only. dateModified is included only
// when the post has a real updatedDate; there are no article images.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  ...(contentUpdatedDate && { "dateModified": contentUpdatedDate.toISOString() }),
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "author": { "@type": "Organization", "name": author },
  "publisher": {
    "@type": "Organization",
    "name": site.name,
    "url": `${site.url}${locale === 'fr' ? '/fr/' : '/'}`,
    "logo": { "@type": "ImageObject", "url": `${site.url}/apple-touch-icon.png` }
  },
  "inLanguage": locale
};

const phrasesPromptHtml = t.blog.phrasesPrompt.replace(
  '{link}',
  `<a href="${phrasesHref}">${t.blog.phrasesPromptLink}</a>`
);
---

<Layout
  title={title}
  seoTitle={post.data.seoTitle}
  description={description}
  ogType="article"
  schema={articleSchema}
  locale={locale}
  alternates={alternates}
  langSwitch={langSwitch}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  />

  <!-- .article-page scopes the blog tokens and Nav theming (src/styles/blog.css) -->
  <div class="article-page">
    <Nav locale={locale} langSwitch={langSwitch} />

    <main>
      <article class="container article">
        <div class="article-inner">

          <a href={blogPath(locale)} class="article-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            {t.blog.allArticles}
          </a>

          <header class="article-header">
            <p><span class="blog-label">{categoryLabel}</span></p>
            <h1 class="article-title">{title}</h1>
            <p class="article-description">{description}</p>
            <p class="blog-meta">
              <span>{author}</span>
              <span aria-hidden="true">·</span>
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime}</span>
            </p>
          </header>

          <div class:list={["article-body", { "hebrew-alphabet-guide": pairKey === "hebrew-alphabet-complete-guide" }]}>
            <Content />
            {showPhrasesLink && <p set:html={phrasesPromptHtml} />}
          </div>

          {post.data.faq && <Faq
            title={t.blog.faqTitle}
            items={post.data.faq}
            surface="white"
          />}

          {post.data.showAppCta && <div class="article-cta">
            <p class="article-cta-text">{t.blog.ctaText}</p>
            <StoreButtons location="blog_article" trackAlso="blog_cta_click" height={48} locale={locale} />
          </div>}

        </div>
      </article>

      <RelatedPosts posts={related} locale={locale} />
    </main>

    <Footer locale={locale} />
  </div>
</Layout>
