---
import { formatPostDate, type BlogPost } from '../../lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, category, readingTime } = post.data;
---

<!-- Styles live in src/styles/blog.css. The title link is stretched over the
     whole card, so the card is clickable without nesting links. -->
<article class="blog-card">
  <div class="blog-card-top">
    <span class="blog-label">{category}</span>
    <span class="blog-card-reading">{readingTime}</span>
  </div>
  <h3 class="blog-card-title">
    <a href={`/blog/${post.slug}/`} class="blog-card-link">{title}</a>
  </h3>
  <p class="blog-card-excerpt">{description}</p>
  <time class="blog-card-date" datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
</article>
