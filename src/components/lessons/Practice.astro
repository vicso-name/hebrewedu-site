---
import type { CollectionEntry } from 'astro:content';
import HebrewText from './HebrewText.astro';
import { unavailableQuestions, exerciseExplanation, derangedPairOrder } from '../../lib/lessons/presentation.mjs';
type Lesson = CollectionEntry<'lessons'>['data'];
interface Props { exercises: Lesson['exercises']; blocks: Lesson['blocks']; letter: string }
const { exercises, blocks, letter } = Astro.props;
const grading = exercises.filter(exercise => !unavailableQuestions.has(exercise.id)).map(exercise => exercise.type === 'MATCH_PAIRS'
  ? { id: exercise.id, type: exercise.type, pairs: exercise.pairs.map(({ id }) => ({ id })) }
  : { id: exercise.id, correctOptionId: exercise.correctOptionId, options: exercise.options.map(({ id }) => ({ id })) });
const gradingJson = JSON.stringify(grading).replace(/</g, '\\u003c');
---
<section id="stage-practice" data-stage="practice" class="stage-panel" aria-labelledby="practice-title">
  <div class="stage-heading"><span class="eyebrow">Step 3 of 4</span><h2 id="practice-title" data-stage-heading tabindex="-1">Put it into practice</h2><p>Choose an answer, check it, then read the explanation.</p></div>
  <div class="practice-meter" data-enhanced hidden><p data-progress aria-live="polite" aria-atomic="true">0 of 14 answered · 0 correct</p><progress data-practice-progress max="14" value="0" aria-label="Questions answered">0 of 14 answered</progress></div>
  <noscript><p class="no-script">Interactive checking needs JavaScript. All questions remain readable; open “Source answer and explanation” to check your work.</p></noscript>
  <div data-practice data-lesson-letter={letter}>
    {exercises.map((exercise, index) => <form class="question-card learning-card" id={exercise.id} data-exercise-id={exercise.id} data-exercise-type={exercise.type} data-unavailable={unavailableQuestions.has(exercise.id) ? 'true' : undefined}>
      <p class="question-count">Question {index + 1} of {exercises.length} <span>{exercise.type === 'MATCH_PAIRS' ? 'Match each pair' : exercise.type === 'TRUE_FALSE' ? 'True or false' : 'Choose one answer'}</span></p>
      {unavailableQuestions.has(exercise.id) ? <>
      <div class="unavailable-question"><p>This question is not available in this preview.</p><p>Continue to the next question.</p></div>
      <div class="question-advance" data-enhanced hidden><button type="button" class="btn lesson-primary" data-advance hidden><span data-advance-label>Next question</span> <span aria-hidden="true">→</span></button></div>
      </> : exercise.type === 'MATCH_PAIRS' ? <>
      <fieldset><legend><HebrewText text={exercise.prompt} /></legend>
        <div class="match-pairs-board" role="group" aria-label="Match each item on the left with its pair on the right">
          <div class="match-pairs-column" data-pairs-side="left">
            {exercise.pairs.map(pair => <button type="button" class="match-pairs-item" data-pair-id={pair.id} data-pair-side="left" aria-pressed="false" aria-label={`Left: ${pair.left}`}><HebrewText text={pair.left} /></button>)}
          </div>
          <div class="match-pairs-column" data-pairs-side="right">
            {derangedPairOrder(exercise.pairs, exercise.id).map(pair => <button type="button" class="match-pairs-item" data-pair-id={pair.id} data-pair-side="right" aria-pressed="false" aria-label={`Right: ${pair.right}`}><HebrewText text={pair.right} /></button>)}
          </div>
        </div>
      </fieldset>
      <p id={`${exercise.id}-feedback`} class="answer-feedback match-pairs-feedback" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
      <div class="answer-explanation" data-explanation hidden><p><strong>Explanation</strong></p><p><HebrewText text={exerciseExplanation(exercise, blocks)} /></p></div>
      <div class="question-advance" data-enhanced hidden><button type="button" class="btn lesson-primary" data-advance hidden><span data-advance-label>Next question</span> <span aria-hidden="true">→</span></button></div>
      <details class="fallback-answer" data-fallback-answer><summary>Source answer and explanation</summary><ul class="match-pairs-answer-key">{exercise.pairs.map(pair => <li><HebrewText text={pair.left} /> matches <HebrewText text={pair.right} /></li>)}</ul><p><HebrewText text={exerciseExplanation(exercise, blocks)} /></p></details>
      </> : <>
      <fieldset><legend><HebrewText text={exercise.prompt} /></legend>
        <div class:list={['answer-options', { 'answer-grid': exercise.type === 'MULTIPLE_CHOICE_GRID', 'answer-boolean': exercise.type === 'TRUE_FALSE' }]}>
          {exercise.options.map(option => <label class="answer-option" for={option.id}><input type="radio" name={exercise.id} id={option.id} value={option.id} required aria-describedby={`${exercise.id}-feedback`} /><span class:list={{ 'glyph-option': /^[\u0590-\u05FF]+$/u.test(option.label) }}><HebrewText text={option.label} /></span></label>)}
        </div>
      </fieldset>
      <div class="answer-actions" data-enhanced hidden><button type="submit" class="btn lesson-primary">Check answer</button><button type="button" class="btn lesson-secondary" data-retry hidden>Retry this question</button></div>
      <p id={`${exercise.id}-feedback`} class="answer-feedback" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
      <div class="answer-explanation" data-explanation hidden><p><strong>Explanation</strong></p><p><HebrewText text={exerciseExplanation(exercise, blocks)} /></p></div>
      <div class="question-advance" data-enhanced hidden><button type="button" class="btn lesson-primary" data-advance hidden><span data-advance-label>Next question</span> <span aria-hidden="true">→</span></button></div>
      <details class="fallback-answer" data-fallback-answer><summary>Source answer and explanation</summary><p><strong>Source answer: </strong><HebrewText text={exercise.options.find(option => option.id === exercise.correctOptionId)!.label} /></p><p><HebrewText text={exerciseExplanation(exercise, blocks)} /></p></details>
      </>}
    </form>)}
  </div>
  <script type="application/json" id="lesson-grading" set:html={gradingJson} />
</section>
<script>
import { initPractice } from '../../lib/lessons/practice-client';
initPractice();
</script>
