---
import type { CollectionEntry } from 'astro:content';
import HebrewText from './HebrewText.astro';
import PhraseCard from '../phrases/PhraseCard.astro';
import type { Phrase } from '../../data/hebrew-phrases';
import { studyText } from '../../lib/lessons/presentation.mjs';
import { localizeTypography } from '../../lib/fr-typography.mjs';
import type { Locale } from '../../i18n';
type Lesson = CollectionEntry<'lessons'>['data'];
interface Props { block: Lesson['blocks'][number]; locale?: Locale }
const { block, locale = 'en' } = Astro.props;
// Snapshot text is corrected for French typography here — see src/lib/fr-typography.mjs.
const fr = (value: string) => localizeTypography(locale, value);
const text = fr(studyText(block));
const blockText = fr(block.text);
const illustration = 'illustration' in block ? localizeTypography(locale, block.illustration) : null;
const wordExamplePhrase: Phrase | null = block.type === 'WORD_EXAMPLE' ? {
  id: block.id, meaning: blockText, usage: '', genderNote: '', references: [], referenceNote: '',
  variants: [{ id: 'same', label: 'Same form', hebrew: block.word, transliteration: block.transcription }],
} : null;
---
<div class:list={['study-block', `study-${block.type.toLowerCase()}`]} data-study-type={block.type} id={block.id}>
  {block.type === 'MAIN_TITLE' && <h1><HebrewText text={blockText} /></h1>}
  {block.type === 'SUBTITLE' && <h2><HebrewText text={blockText} /></h2>}
  {block.type === 'SIMPLE_TEXT' && <p><HebrewText text={blockText} /></p>}
  {block.type === 'BOLD_TEXT' && <p class="sound-note"><strong><HebrewText text={text} /></strong></p>}
  {wordExamplePhrase && <PhraseCard phrase={wordExamplePhrase} meaningTag="p" locale={locale} />}
  {block.type === 'TEXT_IMAGE' && illustration && <figure class="mark-card">
    <div class="mark-glyph" aria-hidden="true"><bdi class="hebrew" lang="he" dir="rtl">{illustration.glyph}</bdi></div>
    <figcaption>
      <h2>{illustration.label}</h2>
      <p><HebrewText text={text} /></p>
      <p class="text-equivalent"><bdi class="hebrew" lang="he" dir="rtl">{illustration.glyph}</bdi> · {illustration.equivalent}</p>
    </figcaption>
  </figure>}
</div>
