---
import { Picture } from 'astro:assets';
import keyArt from '../../assets/play/alef-bet-rush-key-art.png';

interface Props {
  sizes: string;
  alt?: string;
  loading?: 'lazy' | 'eager';
  fit?: 'natural' | 'contain';
}
const {
  sizes,
  alt = 'Alef Bet Rush Hebrew alphabet learning game in a space adventure',
  loading = 'lazy',
  fit = 'natural',
} = Astro.props;
---
<div class:list={['key-art', { 'key-art--contain': fit === 'contain' }]}>
  <Picture
    src={keyArt}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    width={960}
    widths={[320, 480, 640, 960, 1280]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    decoding="async"
  />
</div>

<style>
  .key-art { width: 100%; }
  .key-art :global(img) { display: block; width: 100%; height: auto; border-radius: var(--home-radius-md); }
  .key-art--contain, .key-art--contain :global(picture) { display: block; height: 100%; }
  .key-art--contain :global(img) { height: 100%; object-fit: contain; }
</style>
