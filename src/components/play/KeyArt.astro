---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** A game's key art, imported from src/assets/play/. */
  src: ImageMetadata;
  /** Passed by the page, never defaulted here: shared components carry no English literals. */
  alt: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
  fit?: 'natural' | 'contain' | 'cover';
}
const {
  src,
  alt,
  sizes,
  loading = 'lazy',
  fit = 'natural',
} = Astro.props;
---
<div class:list={['key-art', { 'key-art--contain': fit === 'contain', 'key-art--cover': fit === 'cover' }]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    width={960}
    widths={[320, 480, 640, 960, 1280]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    decoding="async"
  />
</div>

<style>
  .key-art { width: 100%; }
  .key-art :global(img) { display: block; width: 100%; height: auto; border-radius: var(--home-radius-md); }
  .key-art--contain, .key-art--contain :global(picture) { display: block; height: 100%; }
  .key-art--contain :global(img) { height: 100%; object-fit: contain; }
  .key-art--cover :global(img) { aspect-ratio: 16 / 9; height: auto; object-fit: cover; }
</style>
