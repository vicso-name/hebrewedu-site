---
// Shared [bracketed] transliteration rendering (cards, dialogues, practice, hero).
// Brackets are decorative for screen readers: aria-hidden, separate from the text.
interface Props { text: string }
const { text } = Astro.props;
---
<span class="translit-b" aria-hidden="true">[</span><span class="translit-t">{text}</span><span class="translit-b" aria-hidden="true">]</span>
