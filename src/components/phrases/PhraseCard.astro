---
import type { Phrase } from '../../data/hebrew-phrases';
import HebrewText from '../lessons/HebrewText.astro';
import Transliteration from './Transliteration.astro';

interface Props { phrase: Phrase }
const { phrase } = Astro.props;

// Current data only ever has 0 or 1 variant axis (speaker OR addressee),
// never both at once — so a card has at most one "Said by/to" row.
const hasVariants = phrase.variants.length > 1;
const axis: 'by' | 'to' = hasVariants && phrase.variants[0].label.includes('addressee') ? 'to' : 'by';
const varLabel = axis === 'to' ? 'Said to' : 'Said by';
const labelId = `${phrase.id}-${axis}`;

const defaultVariant = phrase.variants[0];
const hebrewLetterCount = (text: string) => (text.match(/[א-ת]/g) ?? []).length;
const isLong = hebrewLetterCount(defaultVariant.hebrew) >= 18;

const dataForms = hasVariants
  ? JSON.stringify({ m: [phrase.variants[0].hebrew, phrase.variants[0].transliteration], f: [phrase.variants[1].hebrew, phrase.variants[1].transliteration] })
  : undefined;
---
<article class={`pc${isLong ? ' pc--long' : ''}`} id={`phrase-${phrase.id}`} role="listitem" data-forms={dataForms}>
  <div class="pc-panel">
    <div class="pc-heb" aria-live="polite">
      <p class="pc-he" lang="he" dir="rtl"><HebrewText text={defaultVariant.hebrew} /></p>
      <p class="pc-tr" lang="he-Latn"><Transliteration text={defaultVariant.transliteration} /></p>
    </div>
  </div>
  <div class="pc-body">
    <h3 class="pc-en">{phrase.meaning}</h3>
    <p class="pc-note">{phrase.usage}</p>
  </div>
  {hasVariants && <div class="pc-vars">
    <div class="pc-var">
      <span class="pc-var-l" id={labelId}>{varLabel}</span>
      <div class="pc-seg" role="radiogroup" aria-labelledby={labelId}>
        <button type="button" role="radio" data-v="m" aria-checked="true" tabindex={0}>Man</button>
        <button type="button" role="radio" data-v="f" aria-checked="false" tabindex={-1}>Woman</button>
      </div>
    </div>
  </div>}
</article>
<script>
  function initSeg(seg: HTMLElement) {
    const card = seg.closest<HTMLElement>('.pc');
    if (!card || !card.dataset.forms) return;
    const forms: Record<string, [string, string]> = JSON.parse(card.dataset.forms);
    const groups = Array.from(card.querySelectorAll<HTMLElement>('[role="radiogroup"]'));
    const heEl = card.querySelector<HTMLElement>('.pc-he');
    const trEl = card.querySelector<HTMLElement>('.pc-tr .translit-t');

    function update() {
      const key = groups.map((g) => g.querySelector<HTMLElement>('[aria-checked="true"]')?.dataset.v ?? '').join('');
      const form = forms[key];
      if (!form || !heEl || !trEl) return;
      heEl.textContent = form[0];
      trEl.textContent = form[1];
    }

    groups.forEach((group) => {
      const options = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
      function select(button: HTMLButtonElement, focus: boolean) {
        options.forEach((option) => {
          const checked = option === button;
          option.setAttribute('aria-checked', String(checked));
          option.tabIndex = checked ? 0 : -1;
        });
        if (focus) button.focus();
        update();
      }
      group.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[role="radio"]');
        if (button) select(button, false);
      });
      group.addEventListener('keydown', (event) => {
        const index = options.indexOf(document.activeElement as HTMLButtonElement);
        if (index < 0) return;
        const length = options.length;
        let next: number | null = null;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + length) % length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = length - 1;
        else if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); select(options[index], true); return; }
        if (next !== null) { event.preventDefault(); select(options[next], true); }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.pc-seg').forEach(initSeg);
</script>
