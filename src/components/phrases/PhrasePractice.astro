---
import { phraseExercises, phraseVariant } from '../../data/hebrew-phrases';
import HebrewText from '../lessons/HebrewText.astro';
const keys = phraseExercises.map(({ id, correctOptionId, options, explanation }) => ({ id, correctOptionId, options: options.map(({ id }) => ({ id })), explanation }));
const gradingJson = JSON.stringify(keys).replace(/</g, '\\u003c');
---
<div class="phrase-practice" data-phrase-practice>
  <p class="practice-intro">Choose the expression you would use. Check your answer, read the explanation, and try again whenever you like.</p>
  <p class="phrase-practice-progress" data-phrase-progress role="status" aria-live="polite" aria-atomic="true" hidden>0 of 3 answers checked correctly</p>
  <div class="phrase-practice-questions">
    {phraseExercises.map((exercise, index) => <form class="phrase-question" data-phrase-question={exercise.id} novalidate>
      <p class="phrase-question-number">Situation {index + 1} of {phraseExercises.length}</p>
      <fieldset>
        <legend>{exercise.prompt}</legend>
        <div class="phrase-answer-options">
          {exercise.options.map(option => {
            const variant = phraseVariant(option.phraseId, option.variantId);
            return <label class="phrase-answer-option" for={option.id}>
              <input type="radio" id={option.id} name={exercise.id} value={option.id} aria-describedby={`${exercise.id}-feedback`} />
              <span><bdi class="phrases-hebrew" lang="he" dir="rtl"><HebrewText text={variant.hebrew} /></bdi><span class="phrase-option-transliteration" dir="ltr">{variant.transliteration}</span></span>
            </label>;
          })}
        </div>
      </fieldset>
      <div class="phrase-answer-actions" data-phrase-actions hidden>
        <button type="submit" class="btn phrases-primary">Check answer</button>
        <button type="button" class="btn phrases-secondary" data-phrase-retry hidden>Try again</button>
      </div>
      <p class="phrase-feedback" id={`${exercise.id}-feedback`} data-phrase-feedback role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
      <details class="phrase-fallback-answer" data-phrase-fallback>
        <summary>Show answer and explanation</summary>
        <p><strong>Answer: </strong><bdi class="phrases-hebrew" lang="he" dir="rtl"><HebrewText text={phraseVariant(exercise.options.find(option => option.id === exercise.correctOptionId)!.phraseId, exercise.options.find(option => option.id === exercise.correctOptionId)!.variantId).hebrew} /></bdi></p>
        <p>{exercise.explanation}</p>
        <a href={`#phrase-${exercise.options.find(option => option.id === exercise.correctOptionId)!.phraseId}`}>Revisit this phrase</a>
      </details>
    </form>)}
  </div>
  <script type="application/json" data-phrase-keys set:html={gradingJson} />
</div>
<script>
  import { initPhrasePractice } from '../../lib/phrases/practice-client';
  document.querySelectorAll<HTMLElement>('[data-phrase-practice]').forEach(initPhrasePractice);
</script>
