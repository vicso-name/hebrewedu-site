---
import type { PhraseGroup } from '../../data/hebrew-phrases';

interface Props {
  groups: PhraseGroup[];
  ariaLabel: string;
  label?: string;
  /** Unit word after the phrase count, e.g. "phrases" (default) or FR's "expressions". */
  unitLabel?: string;
}

const { groups, ariaLabel, label, unitLabel = 'phrases' } = Astro.props;
const labelId = label ? 'situations-label' : undefined;
---
<nav class="phrases-situations" aria-label={label ? undefined : ariaLabel} aria-labelledby={labelId}>
  {label && <p class="phrases-situations-label" id={labelId}>{label}</p>}
  <ul>
    {groups.map((group) => (
      <li>
        <a class="phrases-situation" href={`#${group.id}`}>
          <span class="phrases-situation-name">{group.title}</span>
          <span class="phrases-situation-meta">{group.phrases.length} {unitLabel} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
.phrases-situations-label { font-size: .875rem; line-height: 1.4; font-weight: 600; color: var(--ink-mid); margin-bottom: var(--space-xs-plus); }
.phrases-situations ul { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-xs-plus); }
.phrases-situation { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-xs-plus);
  height: 100%; min-height: 104px; padding: var(--space-sm); background: var(--white); color: var(--ink);
  border: 1px solid var(--border); border-radius: var(--r-lg); transition: border-color .15s ease, background .15s ease; }
.phrases-situation-name { font-family: var(--font-display); font-size: 1rem; line-height: 1.35; font-weight: 700; }
.phrases-situation-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); font-size: .875rem; line-height: 1.4; color: var(--ink-mid); }
.phrases-situation-meta svg { width: 20px; height: 20px; flex: none; fill: none; stroke: var(--brand-dark); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.phrases-situation:hover { border-color: var(--brand-dark); background: var(--brand-light); }

@media (max-width: 1023px) {
  .phrases-situations ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 767px) {
  .phrases-situations ul { grid-template-columns: 1fr; gap: var(--space-xs); }
  .phrases-situation { min-height: 56px; flex-direction: row; align-items: center; padding: var(--space-xs-plus) var(--space-sm); }
  .phrases-situation-name { font-size: .9375rem; }
  .phrases-situation-meta { flex: none; }
}
@media (prefers-reduced-motion: reduce) { .phrases-situation { transition: none; } }
</style>
