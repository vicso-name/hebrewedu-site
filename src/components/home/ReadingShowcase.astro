---
import Section from '../ui/Section.astro';
import DeviceFrame from '../ui/DeviceFrame.astro';
import ProductScreenshot from '../ui/ProductScreenshot.astro';
import storyShot from '../../assets/screenshots/story.jpg';
import readingShot from '../../assets/screenshots/reading.jpg';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale).home.reading;
---

<Section surface="soft">
  <header class="reading-heading">
    <p class="home-eyebrow">{t.eyebrow}</p>
    <h2 class="home-h2" set:html={t.heading} />
    <p class="home-lead">
      {t.lead}
    </p>
  </header>

  <div class="reading-stage">
    <div class="reading-value">
      <h3 class="home-h3">{t.valueHeading}</h3>
      <p class="home-body">
        {t.valueBody}
      </p>
    </div>
    <div class="reading-visual">
      <div class="reading-device reading-device--back">
        <DeviceFrame variant="secondary">
          <ProductScreenshot src={readingShot} alt={t.altLibrary} sizes="200px" />
        </DeviceFrame>
      </div>
      <div class="reading-device reading-device--main">
        <DeviceFrame>
          <ProductScreenshot
            src={storyShot}
            alt={t.altStory}
            sizes="(max-width: 900px) 232px, 250px"
          />
        </DeviceFrame>
      </div>
    </div>
  </div>

  <ul class="reading-capabilities" role="list">
    {t.capabilities.map(c => <li>{c}</li>)}
  </ul>
</Section>

<style>
.reading-heading {
  max-width: 46rem;
  margin: 0 auto var(--home-gap);
  text-align: center;
}
.reading-heading h2 { margin-block: 1rem var(--home-stack); }

/* One wide, quiet presentation surface: what reading gives you, beside the product */
.reading-stage {
  display: grid;
  grid-template-columns: minmax(0, 0.44fr) minmax(0, 0.56fr);
  align-items: center;
  max-width: 980px;
  height: 540px;
  margin-inline: auto;
  overflow: hidden;
  background: var(--home-surface-white);
  border: 1px solid var(--home-border-subtle);
  border-radius: var(--home-radius-lg);
}

.reading-value {
  padding: 2rem 0 2rem clamp(1.75rem, 4.5vw, 3.5rem);
}
.reading-value h3 { margin-bottom: 1rem; }

/* The opened story leads; the story library sits behind it, lower and smaller.
   Both framed devices run off the stage just above the app's tab bar. */
.reading-visual {
  align-self: stretch;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 4rem;
}
.reading-device { flex: none; }
.reading-device--main {
  position: relative;
  z-index: 1;
  width: 268px;
}
.reading-device--back {
  width: 214px;
  margin-top: 6.125rem;
  margin-right: -70px;
}

.reading-capabilities {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.25rem 0.75rem;
  margin-top: 2rem;
  font-size: 1rem;
  font-weight: 500;
  color: var(--home-text-tertiary);
}
.reading-capabilities li + li::before {
  content: '•';
  margin-right: 0.75rem;
  color: var(--home-border-strong);
}

/* Below this the two devices no longer fit beside the copy: stack copy over product */
@media (max-width: 900px) {
  .reading-stage { grid-template-columns: 1fr; height: auto; }
  .reading-value { max-width: 38rem; padding: 2.25rem 1.5rem 0; }
  .reading-visual { height: 480px; padding-top: 2.5rem; overflow: hidden; }
  .reading-device--main { width: min(64vw, 250px); }
}

@media (max-width: 760px) {
  .reading-heading { text-align: left; margin-inline: 0; }
  .reading-capabilities { justify-content: flex-start; }
}

@media (max-width: 560px) {
  .reading-device--back { display: none; }
}
</style>
