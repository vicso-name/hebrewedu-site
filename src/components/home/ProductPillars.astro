---
import Section from '../ui/Section.astro';
import FeatureGrid, { type FeatureItem } from '../ui/FeatureGrid.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale).home.pillars;

const icons = ['layers', 'target', 'repeat', 'book'] as const;
const features = t.features.map((f, i) => ({ icon: icons[i], title: f.title, description: f.description })) satisfies FeatureItem[];
---

<Section id="features" surface="soft">
  <header class="features-heading">
    <h2 class="home-h2">{t.heading}</h2>
    <p class="home-lead">
      {t.lead}
    </p>
  </header>

  <FeatureGrid items={features} />
</Section>

<style>
.features-heading {
  max-width: 46rem;
  margin: 0 auto clamp(3.5rem, 7vw, 5rem);
  text-align: center;
}
.features-heading p {
  max-width: 41rem;
  margin: var(--home-stack) auto 0;
}

@media (max-width: 560px) {
  .features-heading { text-align: left; margin-inline: 0; }
  .features-heading p { margin-inline: 0; }
}
</style>
