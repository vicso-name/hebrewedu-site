---
import Section from '../ui/Section.astro';
import FeatureGrid, { type FeatureItem } from '../ui/FeatureGrid.astro';

const features = [
  {
    icon: 'layers',
    title: 'Learn the foundations',
    description: 'Alphabet, sounds and Nikud made clear from the start.',
  },
  {
    icon: 'target',
    title: 'Practice what you learn',
    description: 'Focused exercises help turn each lesson into a real skill.',
  },
  {
    icon: 'repeat',
    title: 'Remember what matters',
    description: 'Return to words and material that need more practice.',
  },
  {
    icon: 'book',
    title: 'Read real Hebrew',
    description: 'Move into beginner texts with translation and audio support.',
  },
] satisfies FeatureItem[];
---

<Section id="features" surface="soft">
  <header class="features-heading">
    <h2 class="home-h2">Everything you need to start reading Hebrew</h2>
    <p class="home-lead">
      From your first Hebrew letter to your first real text, everything works
      together in one learning path.
    </p>
  </header>

  <FeatureGrid items={features} />
</Section>

<style>
.features-heading {
  max-width: 46rem;
  margin: 0 auto clamp(3.5rem, 7vw, 5rem);
  text-align: center;
}
.features-heading p {
  max-width: 41rem;
  margin: var(--home-stack) auto 0;
}

@media (max-width: 560px) {
  .features-heading { text-align: left; margin-inline: 0; }
  .features-heading p { margin-inline: 0; }
}
</style>
