---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale).home.supporting;

const features = t.features.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), title: f.title, desc: f.desc }));
---

<Section surface="white">
  <SectionHeading
    title={t.heading}
    lede={t.lede}
  />

  <ul class="support-list" role="list">
    {features.map(f => (
      <li class="support-row">
        <span class="home-num" aria-hidden="true">{f.num}</span>
        <h3 class="home-h3">{f.title}</h3>
        <p class="home-lead">{f.desc}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
.support-list {
  list-style: none;
  border-bottom: 1px solid var(--home-border-subtle);
}

.support-row {
  display: grid;
  grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1.25fr);
  gap: 1rem clamp(1.5rem, 4vw, 4rem);
  align-items: baseline;
  padding-block: clamp(1.75rem, 3vw, 2.5rem);
  border-top: 1px solid var(--home-border-subtle);
}

@media (max-width: 760px) {
  .support-row { grid-template-columns: 1fr; gap: 0.5rem; }
}
</style>
