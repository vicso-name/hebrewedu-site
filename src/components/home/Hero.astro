---
import StoreButtons from '../ui/StoreButtons.astro';
import DeviceFrame from '../ui/DeviceFrame.astro';
import ProductScreenshot from '../ui/ProductScreenshot.astro';
import homeShot from '../../assets/screenshots/home.jpg';
import lessonsShot from '../../assets/screenshots/lessons.jpg';
import readingShot from '../../assets/screenshots/reading.jpg';
import practiceShot from '../../assets/screenshots/practice.jpg';

// The rear phone quietly rotates through these; the front phone never changes.
const rearShots = [lessonsShot, readingShot, practiceShot];
---

<section class="hero">
  <div class="container hero-inner">

    <div class="hero-copy">
      <p class="home-eyebrow">Hebrew for beginners</p>
      <h1 class="home-h1 hero-title">
        <span>Learn to read Hebrew.</span>
        <span class="hero-title-quiet">One clear step at a time.</span>
      </h1>
      <p class="home-lead hero-lead">
        Start with the Aleph Bet, build vocabulary, practise with structured lessons,
        and move toward reading real Hebrew.
      </p>
      <StoreButtons />
    </div>

    <div class="hero-visual">
      <div class="hero-device hero-device--main">
        <DeviceFrame>
          <ProductScreenshot
            src={homeShot}
            alt="HebrewEdu home screen"
            sizes="(max-width: 560px) 72vw, (max-width: 900px) 300px, 320px"
            loading="eager"
          />
        </DeviceFrame>
      </div>

      <!-- Decorative: the rotating screens repeat what the sections below describe -->
      <div class="hero-device hero-device--back" aria-hidden="true">
        <DeviceFrame variant="secondary">
          <div class="hero-slides" id="hero-slides">
            {rearShots.map((shot, i) => (
              <div class:list={['hero-slide', { 'is-active': i === 0 }]}>
                <ProductScreenshot src={shot} alt="" sizes="256px" />
              </div>
            ))}
          </div>
        </DeviceFrame>
      </div>
    </div>

  </div>
</section>

<style>
.hero {
  padding-block: clamp(3rem, 6vw, 5.5rem) var(--home-section-y);
  background: var(--home-surface-white);
}

.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
}

.hero-title {
  margin-top: 1rem;
}
.hero-title span { display: block; }
.hero-title-quiet { color: var(--home-text-secondary); }

.hero-lead {
  max-width: 34rem;
  margin-block: var(--home-stack) 2.25rem;
}

/* Main device in front, second one peeking out lower right behind it */
.hero-visual {
  --device: clamp(230px, 23vw, 320px);
  display: flex;
  justify-content: center;
  align-items: flex-start;
}
.hero-device--main {
  position: relative;
  z-index: 1;
  flex: none;
  width: var(--device);
}
.hero-device--back {
  flex: none;
  width: calc(var(--device) * 0.8);
  margin-left: calc(var(--device) * -0.45);
  margin-top: calc(var(--device) * 0.36);
}

/* Rear screens share one grid cell and crossfade */
.hero-slides { display: grid; }
.hero-slide {
  grid-area: 1 / 1;
  opacity: 0;
  transform: translateY(6px) scale(0.99);
  transition: opacity 1s ease, transform 1s ease;
}
.hero-slide.is-active {
  opacity: 1;
  transform: none;
}

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-visual { --device: min(64vw, 300px); }
}

@media (max-width: 560px) {
  .hero-device--back { display: none; }
  .hero-visual { --device: min(72vw, 300px); }
}
</style>

<script>
// Rotates the rear phone's screen. Skipped on small screens (the rear phone is
// hidden there) and for reduced motion, where the first screen simply stays.
const slides = Array.from(document.querySelectorAll('#hero-slides .hero-slide'));
const wide   = window.matchMedia('(min-width: 561px)');
const calm   = window.matchMedia('(prefers-reduced-motion: reduce)');

let current = 0;

if (slides.length > 1) {
  setInterval(() => {
    if (!wide.matches || calm.matches || document.hidden) return;
    slides[current].classList.remove('is-active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('is-active');
  }, 5000);
}
</script>
