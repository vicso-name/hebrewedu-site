<!-- GA4 Consent Mode v2 defaults + region-gated gtag.js loading (see
     src/lib/analytics-consent.ts). Only rendered in production builds —
     dev/preview never import this component. Must stay the first script
     in <head> so defaults are pushed before anything else can call gtag.
     Reads the page's own `<html lang>` (set by Layout.astro) rather than
     taking a `locale` prop, so it stays a single call site regardless of
     which page renders it. -->
<script>
import { bootstrap } from '../lib/analytics-consent';
import { site } from '../data/site';
bootstrap(site.analyticsId, document.documentElement.lang || 'en');
</script>
