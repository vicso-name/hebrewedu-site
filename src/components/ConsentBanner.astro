---
import { site } from '../data/site';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale);
const privacyHref = locale === 'fr' ? '/fr/confidentialite/' : '/website-privacy/';
---

<!-- Analytics consent banner. Auto-shown only for visitors in the EEA/UK/CH
     region (see analytics-consent.ts) with no stored choice yet. The footer's
     "Privacy choices" button (Footer.astro) reopens it for anyone, anywhere,
     to change their choice. -->
<div id="consent-banner" class="consent-banner" role="region" aria-label={t.common.aria.consent} hidden>
  <div class="consent-banner-card">
    <p class="consent-banner-text">
      {t.consent.text}
      <a href={privacyHref}>{t.consent.privacyPolicy}</a>
    </p>
    <div class="consent-banner-actions">
      <button type="button" class="consent-banner-btn" data-consent-choice="denied">{t.consent.decline}</button>
      <button type="button" class="consent-banner-btn" data-consent-choice="granted">{t.consent.accept}</button>
    </div>
  </div>
</div>

<style>
/* A full-width layer pinned to the bottom: a scrim that fades from grey up to
   transparent sets the card off from whatever the page shows behind it. The
   scrim never takes clicks, so the page stays usable while the banner is up;
   only the card does. Decline and Accept stay equal in weight on purpose. */
.consent-banner {
  position: fixed;
  inset-inline: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  justify-content: center;
  padding: var(--space-2xl) var(--space-sm) var(--space-sm);
  background: linear-gradient(to top, rgba(31, 41, 55, .38), rgba(31, 41, 55, .16) 55%, rgba(31, 41, 55, 0));
  pointer-events: none;
  animation: consent-fade .3s ease-out;
}
.consent-banner[hidden] { display: none; }
.consent-banner-card {
  pointer-events: auto;
  width: 100%;
  max-width: var(--w-narrow);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs) var(--space-sm);
  padding: var(--space-sm-plus) var(--space-md);
  background: var(--white);
  color: var(--ink-mid);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: 0 20px 50px rgba(31, 41, 55, .22), 0 4px 12px rgba(31, 41, 55, .08);
  font-size: 0.9375rem;
  line-height: 1.5;
  animation: consent-rise .35s cubic-bezier(.2, .8, .2, 1);
}
.consent-banner-text { margin: 0; flex: 1 1 16rem; }
.consent-banner-text a { color: inherit; text-decoration: underline; text-underline-offset: 2px; margin-inline-start: .25em; }
.consent-banner-actions { display: flex; gap: var(--space-xs); flex-shrink: 0; }
.consent-banner-btn {
  font: inherit;
  font-weight: 600;
  min-height: 44px;
  padding: var(--space-xs) var(--space-md);
  color: var(--ink);
  background: var(--white);
  border: 1px solid var(--border-dark);
  border-radius: var(--r-full);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.consent-banner-btn:hover { background: var(--surface-soft); border-color: var(--ink-subtle); }
.consent-banner-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
@keyframes consent-fade { from { opacity: 0; } }
@keyframes consent-rise { from { opacity: 0; transform: translateY(16px); } }
@media (prefers-reduced-motion: reduce) {
  .consent-banner, .consent-banner-card { animation: none; }
}
@media (max-width: 480px) {
  .consent-banner { padding: var(--space-xl) var(--space-xs) var(--space-xs); }
  .consent-banner-card { padding: var(--space-sm); }
  .consent-banner-actions { width: 100%; }
  .consent-banner-btn { flex: 1; }
}
</style>

<script>
import { site } from '../data/site';
import { applyChoice, getStoredChoice, inConsentRegion } from '../lib/analytics-consent';
import { track } from '../lib/analytics';

const banner = document.getElementById('consent-banner') as HTMLElement;

function show() { banner.hidden = false; }
function hide() { banner.hidden = true; }

if (inConsentRegion() && !getStoredChoice()) show();

banner.addEventListener('click', (e) => {
  const button = (e.target as Element).closest<HTMLElement>('[data-consent-choice]');
  if (!button) return;
  applyChoice(site.analyticsId, button.dataset.consentChoice as 'granted' | 'denied');
  hide();
});

// "Privacy choices" (footer, every page) reopens the banner for anyone.
document.addEventListener('click', (e) => {
  const el = (e.target as Element).closest('[data-privacy-choices]');
  if (!el) return;
  show();
  banner.querySelector<HTMLElement>('[data-consent-choice="granted"]')?.focus();
});

// Delegated store/CTA tracking (StoreButtons.astro sets data-store/data-cta-location).
document.addEventListener('click', (e) => {
  const el = (e.target as Element).closest<HTMLElement>('[data-store]');
  if (!el) return;
  const sourcePath = location.pathname;
  track(`${el.dataset.store}_click`, { cta_location: el.dataset.ctaLocation ?? 'unknown', source_path: sourcePath });
  if (el.dataset.trackAlso) track(el.dataset.trackAlso, { source_path: sourcePath });
});
</script>
