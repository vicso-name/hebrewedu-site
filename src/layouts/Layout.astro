---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import type { Locale } from '../i18n';

// GA is production-only — never wired up in `astro dev`. See docs/ANALYTICS.md.
const analyticsEnabled = !import.meta.env.DEV;

const OG_LOCALE: Record<Locale, string> = { en: 'en_US', fr: 'fr_FR' };

interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  title?: string;
  /** Optional HTML title override; social metadata continues to use title. */
  seoTitle?: string;
  description?: string;
  image?: string;
  /** og:type — 'article' for blog posts */
  ogType?: 'website' | 'article';
  /** Page-specific JSON-LD. Nothing is emitted when omitted. */
  schema?: Record<string, unknown>;
  /** Draft course previews opt out of indexing; existing pages keep their default. */
  robots?: string;
  /** Opt into shared page chrome; legacy pages retain their existing slotted shell. */
  pageClass?: string;
  mainId?: string;
  /** Drives <html lang>, og:locale, and which dictionary Nav/Footer/ConsentBanner read. */
  locale?: Locale;
  /** hreflang alternates (en, fr, x-default). Omitted entirely when not provided — a
   *  page with no FR counterpart emits no alternate links. */
  alternates?: Alternate[];
}

const {
  title = site.title,
  seoTitle,
  description = site.description,
  image = '/og-image.png',
  ogType = 'website',
  schema,
  robots = 'index, follow',
  pageClass,
  mainId = 'main-content',
  locale = 'en',
  alternates,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    {alternates?.map(alt => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <!-- Primary SEO -->
    <title>{seoTitle ?? title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Viktor Sokoliuk" />
    <meta name="robots" content={robots} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={new URL(image, Astro.site)} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="HebrewEdu" />
    <meta property="og:locale"      content={OG_LOCALE[locale]} />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(image, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon"          href="/apple-touch-icon.png" />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Page-specific head content (e.g. fonts) -->
    <slot name="head" />

    {analyticsEnabled && <AnalyticsHead />}
  </head>
  <body>
    {pageClass ? <div class={pageClass}>
      <a class="layout-skip" href={`#${mainId}`}>Skip to content</a>
      <Nav locale={locale} />
      <main id={mainId}><slot /></main>
      <Footer locale={locale} />
    </div> : <slot />}
    {analyticsEnabled && <ConsentBanner locale={locale} />}
  </body>
</html>

<style>
.layout-skip { position: fixed; top: -120px; left: var(--space-sm); z-index: 500; padding: var(--space-sm); background: var(--white); border: 2px solid var(--brand-dark); border-radius: var(--r-sm); }
.layout-skip:focus { top: var(--space-sm); }
</style>
