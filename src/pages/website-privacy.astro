---
import LegalPage from '../components/legal/LegalPage.astro';

import { formatLegalDate } from '../data/legal';
import { websitePrivacyUpdated } from '../data/website-privacy';

const lastUpdated = formatLegalDate(websitePrivacyUpdated);
---

<LegalPage
  metaTitle="Website Privacy Policy — HebrewEdu"
  description="How the HebrewEdu website (hebrewedu.com) handles your data."
  title="Website Privacy Policy"
  lastUpdated={lastUpdated}
>
    <section>
      <h2>Scope</h2>
      <p>This page covers only the HebrewEdu website at hebrewedu.com. For the HebrewEdu mobile apps, see the <a href="/privacy/">app Privacy Policy</a>.</p>
    </section>

    <section>
      <h2>Analytics</h2>
      <p>HebrewEdu currently does not use analytics cookies or Google Analytics on the website, and the website does not ask you for analytics consent.</p>
      <p>The website does not ask you to create an account or submit personal information. Essential technical data (such as IP address and request details) may still be processed by the hosting and network infrastructure that serves the website, in order to deliver and secure it.</p>
    </section>

    <section>
      <h2>Changes</h2>
      <p>If we introduce analytics on the website in the future, we will update this page before doing so and, where required, ask for your consent first.</p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>Questions about this page: <a href="mailto:vicsothemes@gmail.com">vicsothemes@gmail.com</a></p>
    </section>
</LegalPage>
