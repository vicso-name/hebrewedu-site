---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/home/Hero.astro';
import ProductPillars from '../components/home/ProductPillars.astro';
import LearningJourney from '../components/home/LearningJourney.astro';
import LearningResources from '../components/home/LearningResources.astro';
import ReadingShowcase from '../components/home/ReadingShowcase.astro';
import SupportingFeatures from '../components/home/SupportingFeatures.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import DownloadCTA from '../components/home/DownloadCTA.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';
import { site } from '../data/site';
import { appSchema } from '../data/schema';
import { faqs } from '../data/faq';

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      "url": `${site.url}/`,
      "name": site.name,
      "description": site.description,
      "inLanguage": "en"
    },
    appSchema,
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title={site.title}
  description={site.description}
  schema={pageSchema}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  />

  <!-- .home-page scopes the redesigned homepage tokens (src/styles/home.css) -->
  <div class="home-page">
    <Nav />
    <main>
      <Hero />
      <ProductPillars />
      <LearningJourney />
      <LearningResources />
      <ReadingShowcase />
      <SupportingFeatures />
      <Testimonials />
      <Faq />
      <DownloadCTA />
    </main>
    <Footer />
  </div>
</Layout>
