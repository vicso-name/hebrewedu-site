---
import HomePage from '../components/home/HomePage.astro';

// Stage B: /fr/ is this page's FR counterpart. See HomePage.astro for the
// actual shared template both locales render through.
const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/' },
  { hreflang: 'fr', href: 'https://hebrewedu.com/fr/' },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/' },
];
const langSwitch = { href: '/fr/', label: 'Français' };
---
<HomePage locale="en" alternates={alternates} langSwitch={langSwitch} />
