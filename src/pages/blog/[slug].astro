---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import { getSortedPosts, formatPostDate } from '../../lib/blog';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, author, category, readingTime } = post.data;

const formattedDate = formatPostDate(pubDate);

// Latest three posts, excluding the one being read.
const related = (await getSortedPosts())
  .filter(p => p.slug !== post.slug)
  .slice(0, 3);
---

<Layout title={`${title} | HebrewEdu Blog`} description={description}>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
  />

  <!-- .article-page scopes the blog tokens and Nav theming (src/styles/blog.css) -->
  <div class="article-page">
    <Nav />

    <main>
      <article class="container article">
        <div class="article-inner">

          <a href="/blog/" class="article-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            All articles
          </a>

          <header class="article-header">
            <p><span class="blog-label">{category}</span></p>
            <h1 class="article-title">{title}</h1>
            <p class="article-description">{description}</p>
            <p class="blog-meta">
              <span>{author}</span>
              <span aria-hidden="true">·</span>
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime}</span>
            </p>
          </header>

          <div class="article-body">
            <Content />
          </div>

          <div class="article-cta">
            <p class="article-cta-text">Ready to start learning the Hebrew alphabet?</p>
            <a
              href="https://play.google.com/store/apps/details?id=com.vicsothemes.hebrewforbeginners"
              class="article-cta-btn"
              target="_blank"
              rel="noopener"
            >
              <img src="/googleplay-badge.svg" alt="Get it on Google Play" height="48" />
            </a>
          </div>

        </div>
      </article>

      <RelatedPosts posts={related} />
    </main>

    <Footer />
  </div>
</Layout>
