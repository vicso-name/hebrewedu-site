---
// EN blog article — a thin wrapper over the shared template. Its FR
// counterpart is src/pages/fr/blog/[slug].astro.
import { getCollection } from 'astro:content';
import BlogPostPage from '../../components/blog/BlogPostPage.astro';
import { getSortedPosts, getTranslation, postUrl, type BlogPost } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };

// hreflang is reciprocal or absent (docs/I18N.md §3.3): a post declares
// alternates only once a FR post shares its `translationKey`.
const twin = await getTranslation('en', post);
const alternates = twin
  ? [
      { hreflang: 'en', href: postUrl('en', post.id) },
      { hreflang: 'fr', href: postUrl('fr', twin.id) },
      { hreflang: 'x-default', href: postUrl('en', post.id) },
    ]
  : undefined;
const langSwitch = twin ? { href: `/fr/blog/${twin.id}/` } : undefined;

// Latest three posts, excluding the one being read.
const related = (await getSortedPosts('en'))
  .filter(p => p.id !== post.id)
  .slice(0, 3);
---
<BlogPostPage
  post={post}
  related={related}
  locale="en"
  alternates={alternates}
  langSwitch={langSwitch}
/>
