---
import Faq from '../../components/home/Faq.astro';
import KeyArt from '../../components/play/KeyArt.astro';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import CtaPanel from '../../components/ui/CtaPanel.astro';
import LearningMosaic, { type LearningItem } from '../../components/play/LearningMosaic.astro';
import StoreButtons from '../../components/ui/StoreButtons.astro';
import '../../styles/home.css';
import '../../styles/play.css';
const url = 'https://hebrewedu.com/play/';
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', url, name: 'Free Hebrew Learning Games for Beginners' };
const learningTopics = [
  {
    title: 'Start Your Hebrew Learning Journey',
    description: ['Letters → Nikud → Reading → Words → Vocabulary. Begin with the alphabet, then use vowel marks to start reading. Each step gives the next one a stronger foundation.'],
  },
  {
    title: 'Why Learn Hebrew Through Games?',
    description: ['Games give you a reason to recall what you have just learned. Short rounds, immediate feedback and repeated recognition help you discover which letters are familiar and which still need practice.'],
  },
  {
    title: 'Start with the Hebrew Alphabet',
    description: [
      'New to Hebrew? Pair Alef Bet Rush with our ',
      { text: 'complete Hebrew alphabet guide', href: '/blog/hebrew-alphabet-complete-guide/' },
      '. Use the guide as a reference, then practise recalling the letters in the game.',
    ],
  },
  {
    title: 'What Comes After the Alef Bet?',
    description: [
      'Learn final forms and ',
      { text: 'Nikud vowel marks', href: '/blog/how-to-read-hebrew-nikud/' },
      ', then read real words and beginner stories. Alphabet recognition is the first step toward reading with confidence.',
    ],
  },
] satisfies [LearningItem, LearningItem, LearningItem, LearningItem];
---
<Layout title="Free Hebrew Learning Games Online | HebrewEdu" description="Play free Hebrew learning games for beginners. Start with the Alef Bet and Hebrew letter recognition, then continue learning with HebrewEdu." schema={schema}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
  <div class="home-page play-page"><Nav /><main>
    <section class="play-hero"><div class="container"><div class="play-copy play-hub-copy">
      <p class="home-eyebrow">Learn Hebrew by playing</p><h1 class="home-h1">Free Hebrew Learning Games for Beginners</h1>
      <p class="home-lead">Build Hebrew skills through short interactive games. Start with the Alef Bet, practise recognition, and move step by step toward reading.</p>
    </div></div></section>
    <Section surface="soft" class="play-hub-games"><article class="play-card play-featured"><div class="play-featured-copy">
      <p class="home-eyebrow">Hebrew alphabet · Free browser game</p><h2 class="home-h2">Alef Bet Rush</h2>
      <p>Learn and recognise all 22 Hebrew letters through 24 missions across 8 planets, with native Hebrew letter-name audio.</p>
      <p>Learn, Recognize, Rush and Review: meet the letters, recall their shapes, and revisit what needs more practice.</p>
      <a class="btn btn-primary" href="/play/alef-bet-rush/">Play free</a>
    </div><div class="play-featured-art"><KeyArt alt="" sizes="(max-width: 900px) min(640px, 80vw), (max-width: 1280px) 38vw, 480px" /></div></article></Section>
    <Section>
      <LearningMosaic items={learningTopics} />
    </Section>
    <Faq title="Frequently Asked Questions" items={[
      { q: 'Are these Hebrew games free?', a: 'Alef Bet Rush is free to play in your browser, with no account required.' },
      { q: 'Which game should beginners start with?', a: '' },
      { q: 'Do games replace a Hebrew course?', a: 'Games help you practise a specific skill. Combine them with structured lessons and reading for a broader learning path.' },
    ]}>
      <Fragment slot="answer-1">Start with <a href="/play/alef-bet-rush/">Alef Bet Rush</a> to learn the standard Hebrew letters and their names.</Fragment>
    </Faq>
    <CtaPanel compact>
      <h2 class="home-h2">Learn Beyond the Games</h2>
      <p class="home-lead">Continue with structured Hebrew lessons, vocabulary and reading practice in HebrewEdu.</p>
      <StoreButtons location="play_continue" />
    </CtaPanel>
  </main><Footer /></div>
</Layout>
