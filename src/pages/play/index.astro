---
import Faq from '../../components/home/Faq.astro';
import KeyArt from '../../components/play/KeyArt.astro';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import CtaPanel from '../../components/ui/CtaPanel.astro';
import LearningMosaic, { type LearningItem } from '../../components/play/LearningMosaic.astro';
import StoreButtons from '../../components/ui/StoreButtons.astro';
import '../../styles/home.css';
import '../../styles/play.css';
const url = 'https://hebrewedu.com/play/';
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', url, name: 'Free Hebrew Learning Games for Beginners' };
const learningTopics = [
  {
    title: 'Start Your Hebrew Learning Journey',
    description: ['Letters → Nikud → Reading → Words → Vocabulary. Begin with the alphabet, then use vowel marks to start reading. Each step gives the next one a stronger foundation.'],
  },
  {
    title: 'Why Learn Hebrew Through Games?',
    description: ['Games give you a reason to recall what you have just learned. Short rounds, immediate feedback and repeated recognition help you discover which letters are familiar and which still need practice. Read about ', { text: 'what makes a language-learning game educational', href: '/blog/what-makes-a-language-learning-game-educational/' }, ' and why recognition outside the game matters.'],
  },
  {
    title: 'Start with the Hebrew Alphabet',
    description: [
      'New to Hebrew? Pair Alef Bet Rush with our ',
      { text: 'complete Hebrew alphabet guide', href: '/blog/hebrew-alphabet-complete-guide/' },
      '. Use the guide as a reference, then practise recalling the letters in the game.',
    ],
  },
  {
    title: 'What Comes After the Alef Bet?',
    description: [
      'Learn final forms and ',
      { text: 'Nikud vowel marks', href: '/blog/how-to-read-hebrew-nikud/' },
      ', then read real words and beginner stories. Alphabet recognition is the first step toward reading with confidence.',
    ],
  },
] satisfies [LearningItem, LearningItem, LearningItem, LearningItem];
---
<Layout title="Free Hebrew Learning Games Online | HebrewEdu" description="Play free Hebrew learning games for beginners. Start with the Alef Bet and Hebrew letter recognition, then continue learning with HebrewEdu." schema={schema}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
  <div class="home-page play-page"><Nav /><main>
    <section class="play-hero"><div class="container"><div class="play-copy play-hub-copy">
      <p class="home-eyebrow">Learn Hebrew by playing</p><h1 class="home-h1">Free Hebrew Learning Games for Beginners</h1>
      <p class="home-lead">Build Hebrew skills through short interactive games. Start with the Alef Bet, practise recognition, and move step by step toward reading.</p>
    </div></div></section>
    <Section surface="soft" class="play-hub-games"><div class="play-catalog">
      <article class="play-card play-catalog-card">
        <div class="play-catalog-art"><KeyArt alt="" fit="cover" sizes="(max-width: 900px) min(640px, 90vw), (max-width: 1280px) 42vw, 420px" /></div>
        <p class="home-eyebrow">Hebrew alphabet · Free browser game</p><h2 class="home-h2">Alef Bet Rush</h2>
        <p>Learn and recognise all 22 Hebrew letters through 24 missions across 8 planets, with native Hebrew letter-name audio.</p>
        <p>Learn, Recognize, Rush and Review: meet the letters, recall their shapes, and revisit what needs more practice.</p>
        <div class="play-catalog-cta">
          <a class="btn btn-outline" href="/play/alef-bet-rush/">Read More</a>
          <a class="btn btn-primary" href="/play/alef-bet-rush/game/">Play Now</a>
        </div>
      </article>
      <article class="play-card play-catalog-card">
        <div class="play-catalog-art">
          <img src="/images/play/hebrew-mahjong-key-art.jpg" alt="Hebrew Mahjong game board with Hebrew letter tiles" width="1200" height="675" loading="lazy" decoding="async" />
        </div>
        <p class="home-eyebrow">Hebrew alphabet · Mahjong puzzle</p><h2 class="home-h2">Hebrew Mahjong</h2>
        <p>Match Hebrew letters with their names in a real Mahjong-style puzzle. Clear layered boards, hear recorded letter names, and practise all 22 letters at your own pace.</p>
        <p>Letters unlock gradually, look-alike letters are introduced carefully, and the game brings difficult letters back more often.</p>
        <div class="play-catalog-cta">
          <a class="btn btn-outline" href="/play/hebrew-mahjong/">Read More</a>
          <a class="btn btn-primary" href="/play/hebrew-mahjong/game/">Play Now</a>
        </div>
      </article>
    </div></Section>
    <Section>
      <LearningMosaic items={learningTopics} />
    </Section>
    <Faq title="Frequently Asked Questions" items={[
      { q: 'Are these Hebrew games free?', a: 'Yes. Both Alef Bet Rush and Hebrew Mahjong are free to play in your browser, with no account required.' },
      { q: 'Which game should beginners start with?', a: '' },
      { q: 'Do games replace a Hebrew course?', a: 'Games help you practise a specific skill. Combine them with structured lessons and reading for a broader learning path.' },
    ]}>
      <Fragment slot="answer-1"><a href="/play/alef-bet-rush/">Alef Bet Rush</a> gives you a guided introduction to each letter before practice, while <a href="/play/hebrew-mahjong/">Hebrew Mahjong</a> leans on matching and recognition across a broader board. Either is a reasonable starting point; try both and see which style you enjoy more.</Fragment>
    </Faq>
    <CtaPanel compact>
      <h2 class="home-h2">Learn Beyond the Games</h2>
      <p class="home-lead">Continue with structured Hebrew lessons, vocabulary and reading practice in HebrewEdu.</p>
      <StoreButtons location="play_continue" />
    </CtaPanel>
  </main><Footer /></div>
</Layout>

<style>
  .play-catalog {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--home-gap);
    align-items: stretch;
  }

  .play-catalog-card { display: flex; flex-direction: column; }

  .play-catalog-art {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--home-radius-md);
  }

  .play-catalog-art > img,
  .play-catalog-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-catalog-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .play-catalog-cta .btn {
    flex: 1 1 auto;
    justify-content: center;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .play-catalog { grid-template-columns: 1fr; }

    .play-catalog-cta {
      flex-wrap: nowrap;
    }

    .play-catalog-cta .btn {
      flex: 1 1 0;
      padding-inline: 1rem;
    }
  }

  @media (max-width: 420px) {
    .play-catalog-cta {
      flex-direction: column;
    }

    .play-catalog-cta .btn {
      width: 100%;
    }
  }
</style>
