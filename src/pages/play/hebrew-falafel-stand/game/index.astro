---
import AnalyticsHead from '../../../../components/AnalyticsHead.astro';
const analyticsEnabled = !import.meta.env.DEV;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="dark" />
    <title>Hebrew Falafel Stand | Play</title>
    <link rel="canonical" href="https://hebrewedu.com/play/hebrew-falafel-stand/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {analyticsEnabled && <AnalyticsHead />}
  </head>
  <body>
    <header>
      <a href="/play/hebrew-falafel-stand/">← Back to Hebrew Falafel Stand</a>
    </header>
    <main aria-label="Game player">
      <!-- Trusted same-origin artifact: preserve storage, audio, lifecycle and
           user-triggered Google Play popups without sandbox or extra permissions. -->
      <iframe id="game-frame" src="/game-builds/hebrew-falafel-stand/index.html" title="Hebrew Falafel Stand — Hebrew listening game"></iframe>
    </main>
  </body>
</html>

<script>
import { track } from '../../../../lib/analytics';
import { attachGameMessageListener } from '../../../../lib/game-messages-listener';
track('game_open', { game: 'hebrew-falafel-stand' });
const frame = document.getElementById('game-frame');
if (frame instanceof HTMLIFrameElement) attachGameMessageListener(frame, 'hebrew-falafel-stand');
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { height: 100%; background: #08111f; }
  :global(body) {
    margin: 0;
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    color: #f8fafc;
    font-family: Arial, Helvetica, sans-serif;
  }
  header {
    padding: env(safe-area-inset-top) max(.5rem, env(safe-area-inset-right)) 0 max(.5rem, env(safe-area-inset-left));
    border-bottom: 1px solid #334155;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: .5rem;
    color: inherit;
    font-size: .875rem;
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid #67e8f9; outline-offset: -2px; border-radius: 4px; }
  /* Safe-area insets read as 0 inside the iframe, so the frame keeps the bell
     and the tiles clear of the notch and the home indicator. */
  main {
    min-width: 0;
    min-height: 0;
    padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
