---
import PhrasesPage from '../../../components/phrases/PhrasesPage.astro';
import { phrasesTitle, phrasesDescription, phrasesSchema, phrasesEnabled, phrasesPublished, localPhrasesPreview } from '../../../lib/hebrew-phrases.mjs';
import '../../../styles/hebrew-phrases.css';

// Like the existing course hub, an optional rest route keeps drafts out of production.
export function getStaticPaths() {
  return phrasesEnabled(localPhrasesPreview(import.meta.env.DEV)) ? [{ params: { landing: undefined } }] : [];
}
const published = phrasesPublished();

const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/learn/hebrew-phrases/' },
  { hreflang: 'fr', href: 'https://hebrewedu.com/fr/apprendre/phrases-hebreu/' },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/learn/hebrew-phrases/' },
];
---
<PhrasesPage
  locale="en"
  published={published}
  title={phrasesTitle}
  description={phrasesDescription}
  schema={phrasesSchema()}
  robots={published ? 'index, follow' : 'noindex, nofollow, noarchive'}
  alternates={alternates}
/>
