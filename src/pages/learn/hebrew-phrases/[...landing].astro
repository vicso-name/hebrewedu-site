---
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/ui/Section.astro';
import CtaPanel from '../../../components/ui/CtaPanel.astro';
import StoreButtons from '../../../components/ui/StoreButtons.astro';
import Faq from '../../../components/Faq.astro';
import PhraseCard from '../../../components/phrases/PhraseCard.astro';
import SituationTiles from '../../../components/phrases/SituationTiles.astro';
import PhrasePractice from '../../../components/phrases/PhrasePractice.astro';
import HebrewText from '../../../components/lessons/HebrewText.astro';
import Transliteration from '../../../components/phrases/Transliteration.astro';
import { phraseGroups, phrases, phraseDialogues, phraseQuestions, phraseVariant, phraseReview } from '../../../data/hebrew-phrases';
import { phrasesTitle, phrasesDescription, phrasesSchema, phrasesEnabled, phrasesPublished, localPhrasesPreview } from '../../../lib/hebrew-phrases.mjs';
import '../../../styles/hebrew-phrases.css';

// Like the existing course hub, an optional rest route keeps drafts out of production.
export function getStaticPaths() {
  return phrasesEnabled(localPhrasesPreview(import.meta.env.DEV)) ? [{ params: { landing: undefined } }] : [];
}
const published = phrasesPublished();
const phraseById = (id: string) => phrases.find(phrase => phrase.id === id)!;
const resources = [
  { href: '/blog/how-to-learn-hebrew-vocabulary/', title: 'Remember the phrases you learn', description: 'Build a manageable vocabulary and review habit.' },
  { href: '/blog/hebrew-alphabet-complete-guide/', title: 'Look up Hebrew letters', description: 'Keep letter shapes, names and final forms close at hand.' },
  { href: '/learn/hebrew-alphabet/', title: 'Start with the alphabet', description: 'Meet Aleph in the published first alphabet lesson.' },
];
---
<Layout pageClass="phrases-page" mainId="phrases-content" title={phrasesTitle} description={phrasesDescription} schema={phrasesSchema()} robots={published ? 'index, follow' : 'noindex, nofollow, noarchive'}>
      <Section class="phrases-hero phrases-hero--deck" aria-labelledby="phrases-title">
        {!published && <p class="phrases-preview" role="note">Local editorial preview · Native Hebrew review is pending. This page is excluded from the production build.</p>}
        <nav class="phrases-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Hebrew Phrases</li></ol></nav>
        <div class="phrases-hero-layout">
          <header>
            <p class="phrases-eyebrow">A little Hebrew for everyday life</p>
            <h1 id="phrases-title">Useful Hebrew Phrases for Beginners</h1>
            <p class="phrases-lead">Say hello. Order a coffee. Ask for a little help. Start with 30 practical Modern Hebrew expressions, with English meanings and pronunciation support.</p>
            <div class="phrases-hero-actions"><a href="#phrases" class="btn phrases-primary">Explore the phrases <span aria-hidden="true">↓</span></a><a href="#practice" class="btn phrases-secondary">Try a quick practice</a></div>
            <p class="phrases-hero-meta">5 everyday situations <span aria-hidden="true">·</span> Free to use here <span aria-hidden="true">·</span> No installation needed</p>
          </header>
          <aside class="phrases-deck" aria-label="Three greetings to start with">
            <ul class="phrases-deck-list">
              <li><PhraseCard phrase={phraseById('hello')} meaningTag="p" /></li>
              <li><PhraseCard phrase={phraseById('good-morning')} meaningTag="p" /></li>
              <li><PhraseCard phrase={phraseById('goodbye')} meaningTag="p" /></li>
            </ul>
          </aside>
        </div>
      </Section>

      <Section surface="soft" id="how-to-use">
        <div class="phrases-section-heading"><p class="phrases-eyebrow">Read it. Understand it. Use it.</p><h2 class="display-md">How to use this phrase guide</h2></div>
        <div class="phrases-anatomy">
          <figure class="phrases-anatomy-card" aria-label="Example phrase card. Its parts are explained in the list.">
            <PhraseCard phrase={phraseById('coffee-please')} meaningTag="p" idPrefix="anatomy-" />
          </figure>
          <ol class="phrases-anatomy-legend">
            <li><div><h3>Hebrew with nikud</h3><p>The dots and marks around the Hebrew letters are nikud, which help show vowel sounds. <a href="/blog/how-to-read-hebrew-nikud/">Understand Hebrew vowel marks</a>.</p></div></li>
            <li><div><h3>[Transliteration]</h3><p>Transliteration is an approximation: <em>sh</em> as in “shoe”, <em>ts</em> as in “cats”, and <em>kh</em> for a sound like the ending of Scottish “loch”. An apostrophe separates vowel sounds.</p></div></li>
            <li><div><h3>English meaning</h3><p>Follow the meaning, so you know what you are saying.</p></div></li>
            <li><div><h3>Usage note</h3><p>The situation the phrase fits, so you know when to use it.</p></div></li>
            <li><div><h3>Said by / Said to</h3><p>“Said by” is the person saying the phrase; “Said to” is the person you are speaking to. These examples address one person.</p></div></li>
          </ol>
        </div>
      </Section>

      <Section id="phrases">
        <div class="phrases-section-heading"><p class="phrases-eyebrow">30 expressions. Plenty of small beginnings.</p><h2 class="display-md">Everyday Hebrew phrases</h2><p>Choose a situation and learn a few phrases you can put to use.</p></div>
        <SituationTiles groups={phraseGroups} ariaLabel="Phrase situations" />
        {phraseGroups.map((group, groupIndex) => <>
          <div class="phrase-group" id={group.id} role="region" aria-labelledby={`${group.id}-title`}>
            <header class="phrase-group-heading"><div><h3 id={`${group.id}-title`}>{group.title}</h3><p>{group.description}</p></div></header>
            <div class="phrase-grid" role="list">{group.phrases.map((phrase) => <PhraseCard phrase={phrase} id={`phrase-${phrase.id}`} />)}</div>
          </div>
          {groupIndex === 1 && <aside class="phrases-inline-app" aria-labelledby="phrases-mid-title"><div><p id="phrases-mid-title" class="phrases-app-label">Build a regular Hebrew practice habit</p><p>Keep building with vocabulary review and structured lessons in HebrewEdu.</p></div><StoreButtons location="hebrew_phrases_mid" height={48} /></aside>}
        </>)}
      </Section>

      <Section surface="soft" id="examples">
        <div class="phrases-section-heading"><p class="phrases-eyebrow">Put the words together</p><h2 class="display-md">Two small conversations</h2><p>See how phrases you have just learned can work in an exchange.</p></div>
        <div class="phrase-dialogues">{phraseDialogues.map(dialogue => <div class="phrase-dialogue" data-phrase-dialogue={dialogue.id}>
          <h3>{dialogue.title}</h3><p class="phrase-dialogue-setting">{dialogue.setting}</p>
          <ol>{dialogue.turns.map(turn => {
            const variant = phraseVariant(turn.phraseId, turn.variantId);
            return <li><p class="phrase-form-label">{turn.role}</p><p class="phrase-hebrew-line"><bdi class="phrases-hebrew" lang="he" dir="rtl"><HebrewText text={variant.hebrew} /></bdi></p><p class="phrase-transliteration" lang="he-Latn" dir="ltr"><Transliteration text={variant.transliteration} /></p><p>{turn.translation}</p></li>;
          })}</ol>
        </div>)}</div>
      </Section>

      <Section id="practice">
        <div class="phrases-section-heading"><p class="phrases-eyebrow">Your turn</p><h2 class="display-md">Try a quick phrase practice</h2><p>Three everyday situations. No timer, no pressure.</p></div>
        <PhrasePractice />
      </Section>

      <CtaPanel id="phrases-app" compact>
        <p class="phrases-eyebrow">Keep the habit going</p><h2 class="display-md">Continue learning with HebrewEdu</h2>
        <p>Build on these phrases with vocabulary review, structured lessons and beginner reading with audio and translation.</p>
        <StoreButtons location="hebrew_phrases_after_practice" height={48} />
      </CtaPanel>

      <Faq id="questions" title="Beginner questions" items={phraseQuestions.map(item => ({ q: item.question, a: item.answer }))} />
      <Section id="keep-learning">
        <div class="phrases-section-heading"><h2 class="display-md">Keep learning Hebrew</h2><p>Use a reference when you need it, or give your practice a little structure.</p></div>
        <ul class="phrases-resources" role="list">{resources.map(resource => <li><h3><a href={resource.href}>{resource.title} <span aria-hidden="true">→</span></a></h3><p>{resource.description}</p></li>)}</ul>
        <p class="phrases-editorial">Created by HebrewEdu.{published && phraseReview.reviewedAt && <> Editorially reviewed <time datetime={phraseReview.reviewedAt}>{phraseReview.reviewedAt}</time>.</>}</p>
      </Section>
</Layout>
