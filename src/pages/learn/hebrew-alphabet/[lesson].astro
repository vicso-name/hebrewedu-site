---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import StudyBlock from '../../../components/lessons/StudyBlock.astro';
import Practice from '../../../components/lessons/Practice.astro';
import '../../../styles/lesson-poc.css';
import { courseManifest, coursePath, lessonEnabled, localCoursePreview } from '../../../lib/alphabet-course.mjs';
import { loadLessonOverrides } from '../../../lib/lessons/editorial.mjs';

export async function getStaticPaths() {
  const preview = localCoursePreview(import.meta.env.DEV);
  const paths = [];
  for (const item of courseManifest.lessons) {
    if (!lessonEnabled(item.slug, preview)) continue;
    const lesson = await getEntry('lessons', item.slug);
    if (!lesson) throw new Error(`The validated content for "${item.slug}" is missing.`);
    paths.push({ params: { lesson: item.slug }, props: { lesson: lesson.data } });
  }
  return paths;
}
const { lesson } = Astro.props;
const lessonMeta = courseManifest.lessons.find(item => item.slug === lesson.id);
if (!lessonMeta) throw new Error('Lesson has no matching curriculum entry.');
const letterName = lessonMeta.name;
const published = lessonMeta.published;
const totalLessons = courseManifest.lessons.length;
const overrides = loadLessonOverrides(lesson.id);
const stageMap = overrides.stageMap;
const copy = overrides.copy;
const stages = ['Theory', 'Examples', 'Practice', 'Results'];
// Every source block occurs once. The examples retain their original relative order.
const theoryIndices = stageMap.theory;
const exampleIndices = stageMap.examples;
// Stage-map entries reference a block's raw sourceIndex (see docs/LESSON_PIPELINE.md),
// not its position in `lesson.blocks` — the two only coincide when nothing is held
// out. Looking blocks up by sourceIndex keeps this correct once a holdout shifts the
// normalized array (as Bet's does).
const blockBySourceIndex = new Map(lesson.blocks.map(block => [block.sourceIndex, block]));
const preview = localCoursePreview(import.meta.env.DEV);
function navTarget(meta, directionLabel) {
  if (!meta) return null;
  return lessonEnabled(meta.slug, preview)
    ? { href: `${coursePath}${meta.slug}/`, label: `${directionLabel}: ${meta.name} ${meta.letter}` }
    : { href: coursePath, label: 'Back to all lessons' };
}
const previousLessonMeta = courseManifest.lessons.find(item => item.order === lessonMeta.order - 1) ?? null;
const nextLessonMeta = courseManifest.lessons.find(item => item.order === lessonMeta.order + 1) ?? null;
const previousNav = navTarget(previousLessonMeta, 'Previous');
const nextNav = navTarget(nextLessonMeta, 'Next');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: lesson.title,
  description: lesson.description,
  inLanguage: 'en',
  educationalLevel: 'Beginner',
  teaches: `Hebrew alphabet: ${letterName}`,
  isPartOf: `https://hebrewedu.com${coursePath}`,
};
---
<Layout
  title={`${lesson.title} | HebrewEdu`}
  description={lesson.description}
  robots={published ? 'index, follow' : 'noindex, nofollow, noarchive'}
  schema={schema}
>
  <div class="lesson-page">
    <a class="lesson-skip" href="#lesson-content">Skip to lesson</a>
    <Nav />
    <main id="lesson-content">
      <Section>
        <div class="lesson-container">
          <header class="lesson-header"><div class="lesson-identity"><div class="letter-token" aria-hidden="true"><bdi class="hebrew" lang="he" dir="rtl">{lesson.glyph}</bdi></div><div><p class="eyebrow">Hebrew alphabet · Lesson {lessonMeta.order} of {totalLessons}</p><p class="lesson-name">{letterName} <bdi class="hebrew" lang="he" dir="rtl">{lesson.glyph}</bdi></p></div></div>
            {!published && <span class="local-preview-label">Local preview</span>}
          </header>
          <nav class="stage-navigation" aria-label="Lesson stages">
            <ol>{stages.map((stage, index) => <li><button type="button" data-stage-target={stage.toLowerCase()} aria-controls={`stage-${stage.toLowerCase()}`} disabled><span class="stage-number" aria-hidden="true">{index + 1}</span><span>{stage}</span></button></li>)}</ol>
          </nav>
          <p class="sr-only" data-stage-announcement role="status" aria-live="polite" aria-atomic="true"></p>
          <section id="stage-theory" data-stage="theory" class="stage-panel" aria-labelledby="theory-title">
            <div class="stage-heading"><span class="eyebrow">Step 1 of 4</span><h2 id="theory-title" data-stage-heading tabindex="-1">{copy.theory.heading}</h2><p set:html={copy.theory.intro} /></div>
            <div class="learning-card">
              <StudyBlock block={blockBySourceIndex.get(theoryIndices[0])} />
              <div class="learning-objectives"><h2>{copy.theory.objectivesHeading}</h2><ul>{copy.theory.objectives.map((item: string) => <li set:html={item} />)}</ul></div>
              <div class="theory-section"><h2>{copy.theory.secondSectionHeading}</h2><StudyBlock block={blockBySourceIndex.get(theoryIndices[1])} /></div>
              <div class="theory-section"><h2>{copy.theory.thirdSectionHeading}</h2><StudyBlock block={blockBySourceIndex.get(theoryIndices[2])} /></div>
            </div>
            <div class="stage-actions" data-enhanced hidden><span>Next, compare the three marks.</span><button type="button" class="btn lesson-primary" data-stage-target="examples">Next: Examples <span aria-hidden="true">→</span></button></div>
          </section>
          <section id="stage-examples" data-stage="examples" class="stage-panel" aria-labelledby="examples-title">
            <div class="stage-heading"><span class="eyebrow">Step 2 of 4</span><h2 id="examples-title" data-stage-heading tabindex="-1">{copy.examples.heading}</h2><p>{copy.examples.intro}</p></div>
            <div class="learning-card example-materials">{exampleIndices.map(index => <StudyBlock block={blockBySourceIndex.get(index)} />)}</div>
            <div class="stage-actions" data-enhanced hidden><button type="button" class="btn lesson-secondary" data-stage-target="theory">Back: Theory</button><button type="button" class="btn lesson-primary" data-stage-target="practice">Next: Practice <span aria-hidden="true">→</span></button></div>
          </section>
          <Practice exercises={lesson.exercises} blocks={lesson.blocks} />
          <section id="stage-results" data-stage="results" class="stage-panel" aria-labelledby="results-title">
            <div class="stage-heading"><span class="eyebrow">Step 4 of 4</span><h2 id="results-title" data-stage-heading tabindex="-1">Your practice results</h2><p>Use your results to decide what to revisit.</p></div>
            <div class="learning-card results-card" data-enhanced hidden>
              <p class="result-percentage" data-result-percentage>0%</p><p class="percentage-label" data-percentage-label>Overall score · correct answers out of available questions</p>
              <dl class="result-stats"><div><dt>Correct</dt><dd data-result-correct>0</dd></div><div><dt>Attempted</dt><dd data-result-attempted>0</dd></div><div><dt>Incorrect</dt><dd data-result-incorrect>0</dd></div><div><dt>Unanswered</dt><dd data-result-unanswered>14</dd></div></dl>
              <p data-results-summary role="status" aria-live="polite" aria-atomic="true"></p>
              <p data-unanswered-list></p>
              <div class="results-actions"><button type="button" class="btn lesson-primary" data-review-mistakes>Review mistakes</button><button type="button" class="btn lesson-secondary" data-answer-unanswered>Answer unanswered</button><button type="button" class="btn lesson-secondary" data-retry-practice>Retry practice</button></div>
              <p class="session-note">Results are saved for this page visit only. They are not synced to the mobile app.</p>
            </div>
            <noscript><p class="no-script">Interactive results need JavaScript. Read the questions above and expand their source answers to check your work.</p></noscript>
            <div class="stage-actions" data-enhanced hidden><button type="button" class="btn lesson-secondary" data-stage-target="practice">Back: Practice</button><button type="button" class="text-button" data-stage-target="theory">Revisit theory</button></div>
          </section>
          {(previousNav || nextNav) && <nav class="lesson-pagination" aria-label="Lesson navigation">
            {previousNav ? <a class="btn lesson-secondary" href={previousNav.href}><span aria-hidden="true">←</span> {previousNav.label}</a> : <span />}
            {nextNav ? <a class="btn lesson-primary" href={nextNav.href}>{nextNav.label} <span aria-hidden="true">→</span></a> : <span />}
          </nav>}
        </div>
      </Section>
    </main>
    <Footer />
  </div>
</Layout>
