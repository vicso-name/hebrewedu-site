---
import { getEntry } from 'astro:content';
import AlphabetLessonPage from '../../../components/lessons/AlphabetLessonPage.astro';
import { courseManifest, coursePath, coursePathFr, lessonEnabled, localCoursePreview } from '../../../lib/alphabet-course.mjs';
import { loadLessonOverrides } from '../../../lib/lessons/editorial.mjs';
import type { Locale } from '../../../i18n';

interface Props {
  locale?: Locale;
}

export async function getStaticPaths() {
  const preview = localCoursePreview(import.meta.env.DEV);
  const paths = [];
  for (const item of courseManifest.lessons) {
    if (!lessonEnabled(item.slug, preview)) continue;
    const lesson = await getEntry('lessons', item.slug);
    if (!lesson) throw new Error(`The validated content for "${item.slug}" is missing.`);
    paths.push({ params: { lesson: item.slug }, props: { lesson: lesson.data } });
  }
  return paths;
}
const { lesson, locale = 'en' } = Astro.props;
const lessonMeta = courseManifest.lessons.find(item => item.slug === lesson.id);
if (!lessonMeta) throw new Error('Lesson has no matching curriculum entry.');
const totalLessons = courseManifest.lessons.length;
const overrides = loadLessonOverrides(lesson.id);
const preview = localCoursePreview(import.meta.env.DEV);
// Only a link to an enabled lesson is ever shown — an unpublished neighbor is omitted,
// not replaced with a placeholder, so the breadcrumb and Results CTA never dead-end.
function navTarget(meta: { slug: string; name: string } | null | undefined) {
  if (!meta || !lessonEnabled(meta.slug, preview)) return null;
  return { href: `${coursePath}${meta.slug}/`, label: meta.name };
}
const previousLessonMeta = courseManifest.lessons.find(item => item.order === lessonMeta.order - 1) ?? null;
const nextLessonMeta = courseManifest.lessons.find(item => item.order === lessonMeta.order + 1) ?? null;
const previousNav = navTarget(previousLessonMeta);
const nextNav = navTarget(nextLessonMeta);

// hreflang/lang-switch only ever point at the FR lesson once it is itself
// published — symmetric with the FR route's own check (src/pages/fr/apprendre/
// alphabet-hebreu/[lesson].astro). None of the 6 currently-published EN lessons
// have a published FR counterpart yet, so this stays a no-op for them today.
const hasFrCounterpart = lessonEnabled(lesson.id, preview, courseManifest, 'fr');
const frHref = `https://hebrewedu.com${coursePathFr}${lesson.id}/`;
const enHref = `https://hebrewedu.com${coursePath}${lesson.id}/`;
const alternates = hasFrCounterpart ? [
  { hreflang: 'en', href: enHref },
  { hreflang: 'fr', href: frHref },
  { hreflang: 'x-default', href: enHref },
] : undefined;
const langSwitch = hasFrCounterpart ? { href: `${coursePathFr}${lesson.id}/` } : undefined;
---
<AlphabetLessonPage
  locale={locale}
  lesson={lesson}
  lessonMeta={lessonMeta}
  totalLessons={totalLessons}
  overrides={overrides}
  coursePath={coursePath}
  homeHref="https://hebrewedu.com/"
  previousNav={previousNav}
  nextNav={nextNav}
  alternates={alternates}
  langSwitch={langSwitch}
/>
