---
import AlphabetHubPage from '../../../components/hub/AlphabetHubPage.astro';
import { courseManifest, courseSchema, curriculum, hubEnabled, localCoursePreview } from '../../../lib/alphabet-course.mjs';
import type { Locale } from '../../../i18n';

interface Props {
  locale?: Locale;
}

// A rest parameter can omit even this index route from an ordinary draft build.
export function getStaticPaths() {
  return hubEnabled(localCoursePreview(import.meta.env.DEV)) ? [{ params: { hub: undefined } }] : [];
}
const { locale = 'en' } = Astro.props;
const preview = localCoursePreview(import.meta.env.DEV);
const letters = curriculum(preview);
// Stage B: /fr/apprendre/alphabet-hebreu/ is this page's FR counterpart.
const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
  { hreflang: 'fr', href: 'https://hebrewedu.com/fr/apprendre/alphabet-hebreu/' },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
];
const langSwitch = { href: '/fr/apprendre/alphabet-hebreu/' };
---
<AlphabetHubPage
  locale={locale}
  letters={letters}
  robots={courseManifest.hub.published ? 'index, follow' : 'noindex, nofollow, noarchive'}
  schema={courseSchema()}
  alternates={alternates}
  langSwitch={langSwitch}
/>
