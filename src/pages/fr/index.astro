---
import HomePage from '../../components/home/HomePage.astro';

// Stage B rework: /fr/ mirrors / 1:1 (same sections, same order, same
// components) through the shared HomePage.astro template — not a separate
// short landing page.
const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/' },
  { hreflang: 'fr', href: 'https://hebrewedu.com/fr/' },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/' },
];
const langSwitch = { href: '/', label: 'English' };
---
<HomePage locale="fr" alternates={alternates} langSwitch={langSwitch} />
