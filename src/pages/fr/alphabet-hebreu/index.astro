---
import AlphabetHubPage, { type HubLetter } from '../../../components/hub/AlphabetHubPage.astro';
import { courseManifest } from '../../../lib/alphabet-course.mjs';
import { getDictionary } from '../../../i18n';

const PAGE_URL = 'https://hebrewedu.com/fr/alphabet-hebreu/';
const t = getDictionary('fr');

// FR hub = EN hub 1:1 (hero, curriculum, "how lessons work", resources, app
// CTA — AlphabetHubPage.astro), same sections/order/components as
// /learn/hebrew-alphabet/. No FR-only sections: the writing-direction/
// nikoud/finals/cursive prose, the 22-letter reference table and the FAQ
// that used to live here moved to docs/seo/research/fr/fr-guide-draft.md,
// a draft for a future FR counterpart of /blog/hebrew-alphabet-complete-guide/.
//
// Glyph/order match scripts/alphabet-course/owner-letter-map.v2.json. French
// display names follow the research's preferred spellings (Aleph not Alef,
// Heth not Het, Noun not Nun, Pé not Pe, etc.) — the lesson pipeline's own
// slug stays the EN one for when a FR lesson route is built. None of these
// 22 letters have a published FR lesson yet, so every curriculum card shows
// "Bientôt" and none link anywhere — never to the EN lesson.
const letterNames = [
  'Aleph', 'Beth', 'Guimel', 'Daleth', 'Hé', 'Vav', 'Zayin', 'Heth', 'Teth', 'Yod',
  'Kaf', 'Lamed', 'Mem', 'Noun', 'Samekh', 'Ayin', 'Pé', 'Tsadi', 'Qof', 'Resh', 'Shin', 'Tav',
];
const letters: HubLetter[] = courseManifest.lessons.map((lesson, i) => ({
  order: lesson.order,
  letter: lesson.letter,
  name: letterNames[i],
  available: false,
  href: null,
}));

const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
  { hreflang: 'fr', href: PAGE_URL },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
];
const langSwitch = { href: '/learn/hebrew-alphabet/', label: 'English' };

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${PAGE_URL}#webpage`,
  url: PAGE_URL,
  name: t.hub.pageTitle,
  description: t.hub.pageDescription,
  inLanguage: 'fr',
};
---
<AlphabetHubPage
  locale="fr"
  letters={letters}
  robots={courseManifest.hub.published ? 'index, follow' : 'noindex, nofollow, noarchive'}
  schema={pageSchema}
  alternates={alternates}
  langSwitch={langSwitch}
/>
