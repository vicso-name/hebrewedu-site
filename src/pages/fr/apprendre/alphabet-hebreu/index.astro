---
import AlphabetHubPage, { type HubLetter } from '../../../../components/hub/AlphabetHubPage.astro';
import { courseManifest, coursePathFr, lessonEnabled, localCoursePreview } from '../../../../lib/alphabet-course.mjs';
import { getDictionary } from '../../../../i18n';
import { frLetterNames } from '../../../../i18n/fr-letters';

const PAGE_URL = 'https://hebrewedu.com/fr/apprendre/alphabet-hebreu/';
const t = getDictionary('fr');
const preview = localCoursePreview(import.meta.env.DEV);

// FR hub = EN hub 1:1 (hero, curriculum, "how lessons work", resources, app
// CTA — AlphabetHubPage.astro), same sections/order/components as
// /learn/hebrew-alphabet/. No FR-only sections: the writing-direction/
// nikoud/finals/cursive prose, the 22-letter reference table and the FAQ
// that used to live here moved to docs/seo/research/fr/fr-guide-draft.md,
// which became the starting draft for /fr/blog/lettres-hebraiques/, the FR
// counterpart of /blog/hebrew-alphabet-complete-guide/ (feat/fr-blog-batch-1).
//
// Glyph/order match scripts/alphabet-course/owner-letter-map.v2.json. French
// display names follow the research's preferred spellings (src/i18n/fr-letters.ts)
// — the lesson pipeline's own slug stays the EN one. A card links to its FR
// lesson only once that lesson's own `locales.fr.published` flag is true
// (src/data/alphabet-course.json) — never to the EN lesson.
const letters: HubLetter[] = courseManifest.lessons.map(lesson => ({
  order: lesson.order,
  letter: lesson.letter,
  name: frLetterNames[lesson.slug] ?? lesson.name,
  available: lessonEnabled(lesson.slug, preview, courseManifest, 'fr'),
  href: lessonEnabled(lesson.slug, preview, courseManifest, 'fr') ? `${coursePathFr}${lesson.slug}/` : null,
}));

const alternates = [
  { hreflang: 'en', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
  { hreflang: 'fr', href: PAGE_URL },
  { hreflang: 'x-default', href: 'https://hebrewedu.com/learn/hebrew-alphabet/' },
];
const langSwitch = { href: '/learn/hebrew-alphabet/' };

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${PAGE_URL}#webpage`,
  url: PAGE_URL,
  name: t.hub.pageTitle,
  description: t.hub.pageDescription,
  inLanguage: 'fr',
};
---
<AlphabetHubPage
  locale="fr"
  letters={letters}
  robots={courseManifest.hub.published ? 'index, follow' : 'noindex, nofollow, noarchive'}
  schema={pageSchema}
  alternates={alternates}
  langSwitch={langSwitch}
/>
